<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SVL.Android.MobileMainView"
             Background="#F5EDE0">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,28,20,32" Spacing="16" MaxWidth="620">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Image Source="avares://SVL.Android/Assets/icon.png" Width="48" Height="48" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SVL" FontSize="23" FontWeight="Bold" Foreground="#3A2B22" />
          <TextBlock Text="Android 开发预览" FontSize="13" Foreground="#806C59" />
        </StackPanel>
      </StackPanel>

      <Border Background="#FAF7EE" BorderBrush="#D4C4A8" BorderThickness="1" CornerRadius="12" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="导入游戏文件" FontSize="21" Foreground="#3A2B22" TextWrapping="Wrap" />
          <TextBlock Text="选择包含正版 PC 版星露谷物语文件的 ZIP，SVL 将复制并检查文件，不会修改原压缩包。" FontSize="14" Foreground="#5C493A" TextWrapping="Wrap" />
          <Border Background="#F3E8CE" CornerRadius="8" Padding="12">
            <TextBlock x:Name="LibraryStatus" FontSize="14" Foreground="#5C493A" TextWrapping="Wrap" />
          </Border>
          <Button x:Name="ImportButton" Content="选择游戏 ZIP" Background="#C66D3F" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <TextBlock x:Name="ActionStatus" FontSize="13" Foreground="#8B5A3A" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Background="#FAF7EE" BorderBrush="#D4C4A8" BorderThickness="1" CornerRadius="12" Padding="18">
        <StackPanel Spacing="8">
          <TextBlock Text="当前支持范围" FontSize="17" Foreground="#3A2B22" />
          <TextBlock Text="当前可导入 PC 版游戏并检查关键文件，文件保存在 SVL 的独立空间。" FontSize="14" Foreground="#5C493A" TextWrapping="Wrap" />
          <TextBlock Text="独立游戏运行环境、Steam 下载和 Mod 管理仍在开发中；此版本暂不能启动游戏。" FontSize="14" Foreground="#806C59" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
