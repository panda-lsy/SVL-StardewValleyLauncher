<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>io.qzz.svl.launcher</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-preview</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <!-- SkiaSharp 3 的 Android 原生库支持 16 KB 内存页设备。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.1" />
    <ProjectReference Include="..\SVL.Core.Platform\SVL.Core.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="..\SVL.Avalonia\Assets\Icons\icon.png" Link="Resources\drawable\icon.png" />
    <AvaloniaResource Include="..\SVL.Avalonia\Assets\Icons\icon.png" Link="Assets\icon.png" />
  </ItemGroup>
</Project>
