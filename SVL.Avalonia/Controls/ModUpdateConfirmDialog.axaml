<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="SVL.Avalonia.Controls.ModUpdateConfirmDialog"
						 x:Name="Root">
	<Border Classes="panel" Padding="14" MinWidth="500">
		<StackPanel Spacing="10">
			<TextBlock Text="{Binding Title, ElementName=Root}" Classes="heroTitle" />
			<TextBlock Text="{Binding Summary, ElementName=Root}" TextWrapping="Wrap" />
			<ListBox Height="180" ItemsSource="{Binding UpdateItems, ElementName=Root}" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
				<Button Content="取消" Command="{Binding CancelCommand, ElementName=Root}" />
				<Button Content="确认更新" Command="{Binding ConfirmCommand, ElementName=Root}" CommandParameter="{Binding UpdateItems, ElementName=Root}" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
