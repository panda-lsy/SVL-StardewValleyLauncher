<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SVL.Avalonia.Controls.ModInstallTargetDialog"
             x:Name="Root">
  <Border Classes="panel" Padding="16" MinWidth="560" MaxWidth="760">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title, ElementName=Root}"
                 Classes="heroTitle"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message, ElementName=Root}"
                 TextWrapping="Wrap"
                 Opacity="0.82" />

      <TextBlock Text="选择要安装 Mod 的 SMAPI/Base 版本"
                 FontSize="13"
                 Opacity="0.72" />
      <Border Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              MinHeight="120"
              MaxHeight="320">
        <ListBox ItemsSource="{Binding TargetDisplayNames, ElementName=Root}"
                 SelectedIndex="{Binding SelectedIndex, ElementName=Root, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="4">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         TextWrapping="Wrap"
                         Margin="8,7" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <TextBlock Text="{Binding EmptyHint, ElementName=Root}"
                 IsVisible="{Binding HasNoTargets, ElementName=Root}"
                 TextWrapping="Wrap"
                 Opacity="0.7" />

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="0,4,0,0">
        <Button Content="确定"
                Command="{Binding ConfirmCommand, ElementName=Root}"
                IsEnabled="{Binding HasTargets, ElementName=Root}"
                MinWidth="80"
                Classes="accent" />
        <Button Content="另存为"
                Command="{Binding SaveAsCommand, ElementName=Root}"
                MinWidth="80" />
        <Button Content="取消"
                Command="{Binding CancelCommand, ElementName=Root}"
                MinWidth="80" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
