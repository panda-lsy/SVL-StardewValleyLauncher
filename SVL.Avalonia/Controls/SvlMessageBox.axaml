<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SVL.Avalonia.Controls.SvlMessageBox"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="680"
        MaxHeight="420"
        WindowStartupLocation="CenterOwner"
        Title="提示"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Border Padding="16"
          Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="10">
    <StackPanel Spacing="16" MaxWidth="640">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
      <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </ScrollViewer>
      <Button Content="确定" HorizontalAlignment="Right" Click="Ok_Click" />
    </StackPanel>
  </Border>
</Window>
