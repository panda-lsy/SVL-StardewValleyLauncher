<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="SVL.Avalonia.Controls.DependencyEnableDialog"
						 x:Name="Root">
	<Border Classes="panel" Padding="14" MinWidth="460">
		<StackPanel Spacing="10">
			<TextBlock Text="{Binding Title, ElementName=Root}" Classes="heroTitle" />
			<TextBlock Text="{Binding Message, ElementName=Root}" TextWrapping="Wrap" />
			<ListBox ItemsSource="{Binding Dependencies, ElementName=Root}" Height="150" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
				<Button Content="取消" Command="{Binding CancelCommand, ElementName=Root}" />
				<Button Content="启用依赖" Command="{Binding EnableCommand, ElementName=Root}" CommandParameter="{Binding Dependencies, ElementName=Root}" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
