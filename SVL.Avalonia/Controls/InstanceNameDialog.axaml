<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="SVL.Avalonia.Controls.InstanceNameDialog"
						 x:Name="Root">
	<Border Classes="panel" Padding="14" MinWidth="420">
		<StackPanel Spacing="10">
			<TextBlock Text="{Binding Title, ElementName=Root}" Classes="heroTitle" />
			<TextBlock Text="实例名称" />
			<TextBox Text="{Binding InstanceName, ElementName=Root, Mode=TwoWay}" Watermark="输入实例名称" />
			<TextBlock Text="{Binding ErrorMessage, ElementName=Root}"
						IsVisible="{Binding HasError, ElementName=Root}"
						Foreground="#D32F2F"
						FontSize="12"
						TextWrapping="Wrap" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
				<Button Content="取消" Command="{Binding CancelCommand, ElementName=Root}" />
				<Button Content="确认" Command="{Binding ConfirmCommand, ElementName=Root}" CommandParameter="{Binding InstanceName, ElementName=Root}" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
