<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="SVL.Avalonia.Controls.GamePathConfirmDialog"
						 x:Name="Root">
	<Border Classes="panel" Padding="14" MinWidth="460">
		<StackPanel Spacing="10">
			<TextBlock Text="{Binding Title, ElementName=Root}" Classes="heroTitle" />
			<TextBlock Text="{Binding Message, ElementName=Root}" TextWrapping="Wrap" />
			<Border Classes="hintCard" Padding="8">
				<TextBlock Text="{Binding PathToConfirm, ElementName=Root}" TextWrapping="Wrap" />
			</Border>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
				<Button Content="取消" Command="{Binding CancelCommand, ElementName=Root}" />
				<Button Content="确认使用此路径" Command="{Binding ConfirmCommand, ElementName=Root}" CommandParameter="{Binding PathToConfirm, ElementName=Root}" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
