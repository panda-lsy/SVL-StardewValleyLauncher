<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 x:Class="SVL.Avalonia.Controls.DownloadProgressDialog"
						 x:Name="Root">
	<Border Classes="panel" Padding="14" MinWidth="460">
		<StackPanel Spacing="10">
			<TextBlock Text="{Binding Title, ElementName=Root}" Classes="heroTitle" />
			<TextBlock Text="{Binding TaskName, ElementName=Root}" TextWrapping="Wrap" />
			<ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, ElementName=Root}" Height="10" />
			<TextBlock Text="{Binding StatusText, ElementName=Root}" Opacity="0.75" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
				<Button Content="取消任务" Command="{Binding CancelCommand, ElementName=Root}" />
				<Button Content="关闭" Command="{Binding CloseCommand, ElementName=Root}" />
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
