<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SVL.Avalonia.Controls"
             x:Class="SVL.Avalonia.Controls.IconPickerDialog"
             x:Name="Root">
  <Border Classes="panel" Padding="14" MinWidth="520">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title, ElementName=Root}" Classes="heroTitle" />
      <TextBlock Text="选择一个预设图标，或上传 PNG 图标。" Opacity="0.78" />

      <ItemsControl ItemsSource="{Binding Options, ElementName=Root}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="controls:IconPickerOption">
            <Button Width="96"
                    Height="96"
                    Margin="0,0,10,10"
                    Command="{Binding SelectOptionCommand, ElementName=Root}"
                    CommandParameter="{Binding}">
              <Border CornerRadius="8"
                      Padding="10"
                      BorderBrush="#66B89B7F"
                      BorderThickness="1"
                      Background="#FFF9F3E5">
                <Grid>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsCustom}">
                    <TextBlock Text="+" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="上传 PNG" FontSize="11" Opacity="0.75" />
                  </StackPanel>

                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding !IsCustom}">
                    <Image Source="{Binding IconPath, Converter={StaticResource AssetImageConverter}}"
                           Width="44"
                           Height="44"
                           Stretch="Uniform" />
                    <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.8" TextAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Command="{Binding CancelCommand, ElementName=Root}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
