<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SVL.Avalonia</AssemblyName>
    <RootNamespace>SVL.Avalonia</RootNamespace>
    <ApplicationIcon>Assets\Icons\icon.ico</ApplicationIcon>
    <Version>1.2.0.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <!-- 由打包脚本显式设置；普通源码构建与旧测试包不得猜测运行时类型。 -->
    <SvlRuntimeMode Condition="'$(SvlRuntimeMode)' == ''">unknown</SvlRuntimeMode>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SVL.RuntimeMode" Value="$(SvlRuntimeMode)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Avalonia 11.2.8 uses the legacy D-Bus Connection API removed in 0.93.
         Version 0.21.3 retains that API and includes the security fix backport. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SVL.Core.Platform\SVL.Core.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Icons/Generated/**;Assets/Icons/Pixel/**" />
  </ItemGroup>
</Project>
