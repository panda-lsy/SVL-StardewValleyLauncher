<Window x:Class="SVL.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:SVL.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
        xmlns:views="clr-namespace:SVL.Desktop.Views"
        mc:Ignorable="d"
        x:Name="WindMain"
        Title="Stardew Valley Launcher"
        Icon="/Images/icon.png"
        Width="1050"
        Height="680"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource ColorBrushBackground}"
        d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="5"
                            CornerRadius="8"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0"
              Height="48"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Background="{DynamicResource ColorBrush2}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo / 返回按钮 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="16,0">
                <!-- 返回按钮 (在版本选择、版本设置、下载失败和MOD详情页面显示) -->
                <Button Width="32"
                        Height="32"
                        Padding="0"
                        Command="{Binding NavigateBackCommand}"
                        Cursor="Hand"
                        Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=Instances;VersionSettings;DownloadFailure;ModDetails}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Padding="8">
                                <TextBlock Text="←"
                                           FontSize="20"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" TargetName="ButtonBorder"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Junimo 图标 (其他页面显示) -->
                <Image Source="/Images/Junimo.png"
                       Width="24"
                       Height="24"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                      Visibility="{Binding CurrentPage, Converter={StaticResource InversePageToVisibilityConverter}, ConverterParameter=Instances;VersionSettings;ModDetails}" />
                <TextBlock x:Name="LauncherAppNameText"
                           Text="SVL"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="{Binding CurrentPage, Converter={StaticResource InversePageToVisibilityConverter}, ConverterParameter=Instances;VersionSettings;ModDetails}" />

                <!-- MOD详情页标题 -->
                <TextBlock Text="资源下载"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="{Binding CurrentPage, Converter={StaticResource PageToVisibilityConverter}, ConverterParameter=ModDetails}" />
            </StackPanel>

            <!-- 导航按钮 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <RadioButton Content="启动"
                             GroupName="Navigation"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBoolConverter}, ConverterParameter=Launch}"
                             Foreground="White"
                             FontSize="14"
                             Padding="12,8"
                             Cursor="Hand"
                             Command="{Binding NavigateToLaunchCommand}">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </RadioButton.Template>
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <RadioButton Content="下载"
                             GroupName="Navigation"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBoolConverter}, ConverterParameter=Download}"
                             Foreground="White"
                             FontSize="14"
                             Padding="12,8"
                             Cursor="Hand"
                             Command="{Binding NavigateToDownloadCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border Background="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <RadioButton
                             GroupName="Navigation"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBoolConverter}, ConverterParameter=DownloadFailure}"
                             Foreground="White"
                             FontSize="14"
                             Padding="12,8"
                             Cursor="Hand"
                             Command="{Binding NavigateToTasksCommand}">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="任务" VerticalAlignment="Center"/>
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#FFEF5350"
                                     Margin="6,0,0,6"
                                     VerticalAlignment="Top"
                                     Stroke="White"
                                     StrokeThickness="0.8"
                                     Visibility="{Binding ShowTaskNavNotification, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </RadioButton.Content>
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border Background="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <RadioButton Content="设置"
                             GroupName="Navigation"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource PageToBoolConverter}, ConverterParameter=Settings}"
                             Foreground="White"
                             FontSize="14"
                             Padding="12,8"
                             Cursor="Hand"
                             Command="{Binding NavigateToSettingsCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border Background="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#33ffffff" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
            </StackPanel>

            <!-- 窗口控制按钮 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- 最小化按钮 -->
                <Button Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        Click="MinimizeButton_Click"
                        Cursor="Hand"
                        ToolTip="最小化">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ButtonShadow"
                                                      Color="#FFFFFFFF"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>
                                <Path x:Name="ButtonIcon"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Data="M0,0 h15 v2 h-15 v-2 Z"
                                      Fill="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 背景颜色渐变 -->
                                                <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                              Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                              To="#33FFFFFF"
                                                              Duration="0:0:0.15">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <!-- 外发光效果 -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               To="8"
                                                               Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0.4"
                                                               Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                              Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                              To="#00FFFFFF"
                                                              Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               To="0"
                                                               Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0"
                                                               Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 缩小动画 -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.85"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.85"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.9"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.9"
                                                               Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 最大化/还原按钮 -->
                <Button x:Name="MaximizeButton"
                        Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        Click="MaximizeButton_Click"
                        Cursor="Hand"
                        ToolTip="最大化">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ButtonShadow"
                                                      Color="#FFFFFFFF"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>
                                <Grid x:Name="MaximizeIcon"
                                      Width="12"
                                      Height="12"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <!-- 最大化图标 -->
                                    <Path x:Name="MaximizePath"
                                          Data="M0,0 h12 v12 h-12 z"
                                          Stroke="White"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Stretch="Fill"/>
                                    <!-- 还原图标（初始隐藏） -->
                                    <Path x:Name="RestorePath"
                                          Data="M2,2 h10 v10 h-10 z M0,0 h10 v10 h-10 z"
                                          Stroke="White"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Stretch="Fill"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 背景颜色渐变 -->
                                                <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                              Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                              To="#33FFFFFF"
                                                              Duration="0:0:0.15">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <!-- 外发光效果 -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               To="8"
                                                               Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0.4"
                                                               Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                              Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                              To="#00FFFFFF"
                                                              Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               To="0"
                                                               Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0"
                                                               Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 缩小动画 -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.85"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.85"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.9"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.9"
                                                               Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 关闭按钮 -->
                <Button Width="28"
                        Height="28"
                        Margin="0,0,12,0"
                        Click="CloseButton_Click"
                        Cursor="Hand"
                        ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ButtonShadow"
                                                      Color="#FFFF4C4C"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>
                                <Path x:Name="ButtonIcon"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                                      Fill="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 背景颜色渐变 -->
                                                <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                              Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                              To="#33FFFFFF"
                                                              Duration="0:0:0.15">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <!-- 图标颜色渐变 -->
                                                <ColorAnimation Storyboard.TargetName="ButtonIcon"
                                                              Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)"
                                                              To="#FF6E5C5C"
                                                              Duration="0:0:0.15"/>
                                                <!-- 红色外发光效果 -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               To="12"
                                                               Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0.5"
                                                               Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                              Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                              To="#00FFFFFF"
                                                              Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetName="ButtonIcon"
                                                              Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)"
                                                              To="#FFFFFFFF"
                                                              Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="BlurRadius"
                                                               To="0"
                                                               Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonShadow"
                                                               Storyboard.TargetProperty="Opacity"
                                                               To="0"
                                                               Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 缩小动画 -->
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.85"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.85"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="0.9"
                                                               Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="0.9"
                                                               Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleX"
                                                               To="1"
                                                               Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale"
                                                               Storyboard.TargetProperty="ScaleY"
                                                               To="1"
                                                               Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.Resources>
                <!-- InstanceSelectorViewModel 的数据模板 -->
                <DataTemplate DataType="{x:Type viewModel:InstanceSelectorViewModel}">
                    <views:InstanceSelectorView />
                </DataTemplate>

                <!-- VersionSettingsViewModel 的数据模板 -->
                <DataTemplate DataType="{x:Type viewModel:VersionSettingsViewModel}">
                    <views:VersionSettingsPageView />
                </DataTemplate>

                <!-- DownloadLeftViewModel 的数据模板 -->
                <DataTemplate DataType="{x:Type viewModel:DownloadLeftViewModel}">
                    <views:DownloadLeftView />
                </DataTemplate>

                <!-- DownloadRightViewModel 的数据模板 -->
                <DataTemplate DataType="{x:Type viewModel:DownloadRightViewModel}">
                    <views:DownloadRightView />
                </DataTemplate>

                <!-- TaskStatusViewModel 的数据模板 -->
                <DataTemplate DataType="{x:Type viewModel:TaskStatusViewModel}">
                    <views:TaskStatusView />
                </DataTemplate>
            </Grid.Resources>

            <!-- 版本选择界面（全屏显示） -->
            <ContentControl Content="{Binding LeftPanelContent}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- 当 LeftPanelContent 是 InstanceSelectorViewModel 时显示 -->
                            <DataTrigger Binding="{Binding LeftPanelContent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RightPanelContent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- 左右分栏布局 -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- 当显示实例选择时，隐藏左右分栏 -->
                            <DataTrigger Binding="{Binding RightPanelContent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- 左侧面板 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ColorBrushTransparentBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource ModernScrollViewerStyle}">
                    <ContentControl Content="{Binding LeftPanelContent}"
                                    Margin="10">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                                                 From="0"
                                                                 To="1"
                                                                 Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <PowerEase Power="2" EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="-15"
                                                                 To="0"
                                                                 Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </ScrollViewer>
            </Border>

            <!-- 分隔线 -->
            <Rectangle Grid.Column="0"
                       Width="1"
                       HorizontalAlignment="Right"
                       Fill="{DynamicResource ColorBrushSemiTransparent}"
                       Opacity="0.3" />

            <!-- 右侧内容面板 -->
            <ScrollViewer x:Name="RightContentScrollViewer"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ModernScrollViewerStyle}"
                          ScrollChanged="RightContentScrollViewer_ScrollChanged">
                <ContentControl Content="{Binding RightPanelContent}"
                                Margin="20">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <PowerEase Power="2" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="20"
                                                             To="0"
                                                             Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
            </Grid>  <!-- 左右分栏布局结束 -->

            <!-- 右下角下载浮动按钮 -->
            <controls:DownloadFloatingButton x:Name="DownloadFloatingButton"
                                           Width="60"
                                           Height="60"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,24,24"
                                           PreviewMouseLeftButtonDown="DownloadFloatingButton_PreviewMouseLeftButtonDown"
                                           PreviewMouseMove="DownloadFloatingButton_PreviewMouseMove"
                                           PreviewMouseLeftButtonUp="DownloadFloatingButton_PreviewMouseLeftButtonUp">
                <controls:DownloadFloatingButton.RenderTransform>
                    <TranslateTransform/>
                </controls:DownloadFloatingButton.RenderTransform>
            </controls:DownloadFloatingButton>
        </Grid>  <!-- 左右分栏布局结束 -->

        <!-- 通知容器（位于所有内容之上） -->
        <Canvas x:Name="NotificationContainer"
                Panel.ZIndex="9999"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"/>
</Grid>  <!-- 主内容区域结束 -->
</Window>
