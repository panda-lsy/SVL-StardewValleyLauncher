<Window x:Class="SVL.Desktop.Controls.ModUpdateConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认更新"
        Width="480"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- 背景遮罩 -->
    <Grid Background="{DynamicResource ColorBrushMask}">
        <Border Width="480"
                Background="{DynamicResource ColorBrushBackground}"
                CornerRadius="8"
                BorderBrush="{DynamicResource ColorBrush3}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.3"
                                  BlurRadius="20"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="确认更新 MOD"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,16"/>

                <!-- MOD 信息 -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ColorBrushTransparentBackground}"
                        BorderBrush="{DynamicResource ColorBrush3}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- MOD 名称 -->
                        <TextBlock>
                            <Run Text="模组：" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <Run Text="{Binding ModName}" Foreground="{DynamicResource ColorBrush1}" FontWeight="Medium"/>
                        </TextBlock>

                        <!-- 版本比较 -->
                        <TextBlock Margin="0,8,0,0">
                            <Run Text="当前版本：" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <Run Text="{Binding CurrentVersion}" Foreground="#FF9800" FontWeight="Medium"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="目标版本：" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <Run Text="{Binding TargetVersion}" Foreground="#4CAF50" FontWeight="Medium"/>
                        </TextBlock>

                        <!-- 操作类型 -->
                        <TextBlock Margin="0,8,0,0">
                            <Run Text="操作：" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <Run Text="{Binding OperationType}" Foreground="{DynamicResource ColorBrush2}" FontWeight="Medium"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 说明文本 -->
                <TextBlock Grid.Row="2"
                           Text="更新任务已添加到下载管理器，请在任务管理页面查看进度。"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <!-- 按钮区 -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0">
                    <!-- 取消按钮 -->
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource ColorBrushGray3}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ColorBrush3}"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 确认按钮 -->
                    <Button x:Name="ConfirmButton"
                            Content="开始更新"
                            Width="100"
                            Height="32"
                            FontSize="12"
                            FontWeight="Medium"
                            Click="ConfirmButton_Click"
                            Background="{DynamicResource ColorBrush2}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
