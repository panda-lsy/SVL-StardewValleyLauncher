<Window x:Class="SVL.Desktop.Controls.GamePathConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="确认游戏本体"
        Width="450"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Border Width="400"
                Background="{DynamicResource ColorBrushBackground}"
                CornerRadius="8"
                BorderBrush="{DynamicResource ColorBrush3}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.3"
                                  BlurRadius="20"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="确认游戏本体 (BASE)"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,12"/>

                <!-- 内容 -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="游戏本体 (BASE) 路径："
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Margin="0,0,0,8"/>

                        <StackPanel x:Name="BasePathSelectorPanel"
                            Margin="0,0,0,12"
                            Visibility="Visible">
                        <TextBlock Text="游戏本体路径：可直接使用当前路径，或展开切换其他已配置 BASE。"
                                   FontSize="11"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="BasePathComboBox"
                                  Style="{StaticResource SettingComboBoxStyle}"
                              IsEditable="True"
                              IsReadOnly="True"
                                  Background="{DynamicResource ColorBrushTransparentBackground}"
                                  BorderBrush="{DynamicResource ColorBrush3}"
                                  BorderThickness="1"
                                  Foreground="{DynamicResource ColorBrush1}"
                                  Padding="10,6"
                                  SelectionChanged="BasePathComboBox_SelectionChanged"/>
                    </StackPanel>

                    <TextBlock Text="将使用此路径作为游戏本体 (BASE)，所有实例将共享此路径的游戏文件。"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="如需更改，请点击 &quot;重新选择&quot;。"
                               FontSize="11"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Opacity="0.7"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           x:Name="ValidationTextBlock"
                           FontSize="11"
                           Foreground="#FF7A7A"
                           Visibility="Collapsed"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <!-- 按钮 -->
                <StackPanel Grid.Row="3"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Margin="0,16,0,0">
                    <Button Content="取消"
                            Width="70"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource ColorBrushGray3}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ColorBrush3}"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="重新选择"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="SelectNew_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource ColorBrushGray3}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ColorBrush3}"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                        <Button x:Name="ConfirmButton"
                            Content="使用此路径"
                            Width="90"
                            Height="32"
                            FontSize="12"
                            Click="Confirm_Click"
                            Background="{DynamicResource ColorBrush2}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
