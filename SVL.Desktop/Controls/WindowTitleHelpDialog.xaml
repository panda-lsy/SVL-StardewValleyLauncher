<Window x:Class="SVL.Desktop.Controls.WindowTitleHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口标题占位符帮助"
        Width="600"
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource ColorBrush5}"
            BorderBrush="{DynamicResource ColorBrushGray3}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ColorBrush2}"
                    CornerRadius="12,12,0,0"
                    Padding="20,16">
                <Grid>
                    <TextBlock Text="💡 窗口标题占位符帮助"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <Button Content="✕"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="16"
                                                    Width="32"
                                                    Height="32"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#33FFFFFF" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel>
                    <TextBlock Text="占位符变量列表"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,16"/>

                    <!-- 占位符列表 -->
                    <ItemsControl ItemsSource="{Binding Placeholders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ColorBrushGray8}"
                                        BorderThickness="0"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Tag}"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource ColorBrush2}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ColorBrush1}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 默认值 -->
                    <Border Background="#FF9500"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="16,12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="默认值模板"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>

                            <TextBlock FontSize="12"
                                       Foreground="White"
                                       LineHeight="18">
                                <Run Text="• 原版游戏："/><LineBreak/>
                                <Run Text="  "/>
                                <Run Text="{Binding DefaultTemplate}" FontWeight="Bold" Foreground="#FFE0B0"/><LineBreak/>
                                <LineBreak/>
                                <Run Text="• SMAPI："/><LineBreak/>
                                <Run Text="  "/>
                                <Run Text="{Binding SmapTemplate}" FontWeight="Bold" Foreground="#FFE0B0"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    BorderThickness="0"
                    CornerRadius="0,0,12,0"
                    Background="Transparent"
                    Padding="24,16">
                <Button Content="关闭"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Center"
                        Padding="32,10"
                        Background="{DynamicResource ColorBrush2}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush1}" TargetName="ButtonBorder"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
