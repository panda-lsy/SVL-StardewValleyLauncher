<Window x:Class="SVL.Desktop.Controls.ModpackFailureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="整合包安装失败"
        Width="550"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 自定义滚动条样式 -->
        <Style x:Key="CustomScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="12">
                            <Rectangle Fill="{DynamicResource ColorBrushMask}"
                                       Opacity="0.5"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Margin="0">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ColorBrush3}"
                                                        CornerRadius="6"
                                                        Margin="2"
                                                        Width="8"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar Orientation="Vertical"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CustomScrollBarStyle}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ColorBrushMask}">
        <Border Width="550"
                Background="{DynamicResource ColorBrushBackground}"
                CornerRadius="8"
                BorderBrush="{DynamicResource ColorBrush3}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.3"
                                  BlurRadius="20"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           x:Name="TitleTextBlock"
                           Text="⚠ 部分模组安装失败"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FF6B6B"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Margin="0,0,0,12"
                           MaxWidth="500"/>

                <!-- 说明信息 -->
                <TextBlock Grid.Row="1"
                           x:Name="SummaryTextBlock"
                           Text="整合包已安装，但有部分模组下载失败。您可以稍后手动下载这些模组。"
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <!-- 失败模组列表 - 使用浅色背景 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource ColorBrushTransparentBackground}"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16"
                        MaxHeight="300"
                        BorderBrush="{DynamicResource ColorBrush3}"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource CustomScrollViewerStyle}">
                        <StackPanel x:Name="FailedModsPanel">
                            <!-- 动态生成失败模组项 -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 分页控制和导出按钮 -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 分页控制 -->
                    <Grid x:Name="PaginationPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 页码信息 -->
                        <TextBlock Grid.Column="1"
                                   x:Name="PageInfoTextBlock"
                                   Text="1 / 1"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Center"/>

                        <!-- 上一页按钮 -->
                        <Button Grid.Column="0"
                                x:Name="PrevPageButton"
                                Content="← 上一页"
                                FontSize="12"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Click="PrevPage_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource ColorBrushGray3}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ColorBrush3}"
                                Cursor="Hand"
                                Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- 下一页按钮 -->
                        <Button Grid.Column="2"
                                x:Name="NextPageButton"
                                Content="下一页 →"
                                FontSize="12"
                                Padding="12,6"
                                HorizontalAlignment="Right"
                                Click="NextPage_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource ColorBrushGray3}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ColorBrush3}"
                                Cursor="Hand"
                                Margin="8,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- 底部按钮区 -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <!-- 导出按钮 -->
                        <Button x:Name="ExportButton"
                                Content="导出列表"
                                Width="80"
                                Height="32"
                                FontSize="12"
                                Margin="0,0,8,0"
                                Click="Export_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource ColorBrushGray3}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ColorBrush3}"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- 关闭按钮 -->
                        <Button x:Name="CloseButton"
                                Content="关闭"
                                Width="80"
                                Height="32"
                                FontSize="12"
                                Click="Close_Click"
                                Background="{DynamicResource ColorBrush2}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
