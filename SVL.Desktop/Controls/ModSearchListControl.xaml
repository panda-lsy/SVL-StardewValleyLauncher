<UserControl x:Class="SVL.Desktop.Controls.ModSearchListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SVL.Desktop.Models"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=controls:ModSearchListControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="models:ModSearchItem">
                <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          Opacity="0.1"
                                          BlurRadius="8"
                                          ShadowDepth="2"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="64"
                                Height="64"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Margin="0,0,16,0"
                                Background="{DynamicResource ColorBrush3}">
                            <Image Source="{Binding LocalIconPath, Converter={StaticResource ImagePathConverter}}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect Color="Black"
                                                      Opacity="0.2"
                                                      BlurRadius="4"
                                                      ShadowDepth="2"/>
                                </Image.Effect>
                            </Image>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Margin="0,0,0,8">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               Margin="0,0,10,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding HasLocalizedName, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="中"
                                                Command="{Binding ShowLocalizedNameCommand}"
                                                Padding="8,2"
                                                Margin="0,0,4,0"
                                                FontSize="11"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource ColorBrush1}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseLocalizedName}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="EN"
                                                Command="{Binding ShowSourceNameCommand}"
                                                Padding="8,2"
                                                FontSize="11"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource ColorBrush1}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseLocalizedName}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplaySummary}"
                                               Margin="0,0,10,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding HasLocalizedDescription, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="中"
                                                Command="{Binding ShowLocalizedDescriptionCommand}"
                                                Padding="8,2"
                                                Margin="0,0,4,0"
                                                FontSize="11"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource ColorBrush1}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseLocalizedDescription}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="EN"
                                                Command="{Binding ShowSourceDescriptionCommand}"
                                                Padding="8,2"
                                                FontSize="11"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource ColorBrush1}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseLocalizedDescription}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Tags -->
                            <WrapPanel Orientation="Horizontal">
                                <Border Background="#FF4A90E2"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        Margin="0,0,6,4">
                                    <TextBlock Text="{Binding Source}"
                                               FontSize="11"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding SupportedGameVersions}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="NexusMods">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ColorBrush3}"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ColorBrushGray3}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- GitHub: Star 数；其他来源：下载量 -->
                                <Border Background="#FF50C878"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        Margin="0,0,6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="GitHub">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11"
                                               Foreground="White"
                                               FontWeight="SemiBold">
                                        <Run Text="📥"/>
                                        <Run Text="{Binding DownloadCount, Converter={StaticResource LongToNumberConverter}}"/>
                                    </TextBlock>
                                </Border>

                                <Border Background="#FF50C878"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        Margin="0,0,6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="GitHub">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11"
                                               Foreground="White"
                                               FontWeight="SemiBold">
                                        <Run Text="★"/>
                                        <Run Text="{Binding DownloadCount, Converter={StaticResource LongToNumberConverter}}"/>
                                    </TextBlock>
                                </Border>

                                <Border Background="#FF9370DB"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        Margin="0,0,6,4">
                                    <TextBlock FontSize="11"
                                               Foreground="White"
                                               FontWeight="SemiBold">
                                        <Run Text="📅"/>
                                        <Run Text="{Binding LastUpdateTime}"/>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Details button (optional) -->
                        <Button Grid.Column="2"
                                Content="查看详情"
                                Width="90"
                                Height="32"
                                FontSize="12"
                                Margin="12,0,0,0"
                                Background="{DynamicResource ColorBrush2}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding ShowDetailsButton, RelativeSource={RelativeSource AncestorType=controls:ModSearchListControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding DetailsCommand, RelativeSource={RelativeSource AncestorType=controls:ModSearchListControl}}"
                                CommandParameter="{Binding}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Click anywhere -->
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding DetailsCommand, RelativeSource={RelativeSource AncestorType=controls:ModSearchListControl}}"
                                     MouseAction="LeftClick"
                                     CommandParameter="{Binding}"/>
                    </Border.InputBindings>

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ColorBrushMask}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
