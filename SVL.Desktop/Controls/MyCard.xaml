<Grid x:Class="SVL.Desktop.Controls.MyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SVL.Desktop.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- 阴影层 -->
    <Border x:Name="ShadowChrome"
            Margin="-3,-3,-3,-4"
            CornerRadius="5"
            IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect x:Name="ShadowEffect"
                            Color="#343d4a"
                            BlurRadius="3"
                            ShadowDepth="0"
                            Opacity="0.07" />
        </Border.Effect>
    </Border>

    <!-- 背景层 -->
    <Border x:Name="BackgroundBorder"
            CornerRadius="5"
            Background="{DynamicResource ColorBrushTransparentBackground}"
            IsHitTestVisible="False" />

    <!-- 内容层 -->
    <Grid x:Name="ContentGrid">
        <!-- 标题 -->
        <TextBlock x:Name="TitleTextBlock"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="15,12,0,0"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="{DynamicResource ColorBrush1}"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />

        <!-- 折叠指示器 -->
        <Path x:Name="SwapPath"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Width="10"
               Height="6"
               Margin="0,17,16,0"
               Stretch="Uniform"
               Data="M2,4 l-2,2 10,10 10,-10 -2,-2 -8,8 -8,-8 z"
               RenderTransformOrigin="0.5,0.5"
               Fill="{DynamicResource ColorBrush1}"
               IsHitTestVisible="False"
               Visibility="Collapsed">
            <Path.RenderTransform>
                <RotateTransform Angle="180" />
            </Path.RenderTransform>
        </Path>

        <!-- 主内容 -->
        <ContentPresenter x:Name="MainContent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="15,35,15,15" />
    </Grid>
</Grid>
