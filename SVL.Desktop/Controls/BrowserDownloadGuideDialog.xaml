<Window x:Class="SVL.Desktop.Controls.BrowserDownloadGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="通过浏览器下载"
        Width="580"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="Transparent">
        <Border Width="540"
                Background="{DynamicResource ColorBrushBackground}"
                CornerRadius="8"
                BorderBrush="{DynamicResource ColorBrush3}"
                BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="请通过浏览器下载"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,16"/>

                <!-- 内容 -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="此文件需要 NexusMods Premium 会员才能直接下载。"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush1}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource ColorBrush2}"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📥 下载步骤"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="1. 在打开的浏览器弹窗中点击「Slow Download」进行下载"
                                           FontSize="11"
                                           Foreground="White"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="2. 等待五秒后，SVL 将自动接收下载并继续安装"
                                           FontSize="11"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="说明：点击按钮后，浏览器将打开 NexusMods 下载页面，请在浏览器中完成下载。"
                               FontSize="11"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 按钮 -->
                <StackPanel Grid.Row="2"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Margin="0,16,0,0">
                    <Button x:Name="CancelButton"
                            Content="稍后下载"
                            Width="90"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource ColorBrushGray3}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ColorBrush3}"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="OpenBrowserButton"
                            Content="打开下载页面"
                            Width="120"
                            Height="32"
                            FontSize="12"
                            Click="OpenBrowser_Click"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
