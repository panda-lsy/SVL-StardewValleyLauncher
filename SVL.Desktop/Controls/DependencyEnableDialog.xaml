<Window x:Class="SVL.Desktop.Controls.DependencyEnableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Width="520"
            MaxHeight="560"
            Background="{DynamicResource ColorBrushBackground}"
            BorderBrush="{DynamicResource ColorBrush3}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="检测到未启用的前置 Mod"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}"/>

            <TextBlock Grid.Row="1"
                       x:Name="DescriptionTextBlock"
                       Margin="0,10,0,14"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       FontSize="12"
                       Foreground="{DynamicResource ColorBrushGray3}"/>

            <Border Grid.Row="2"
                    Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{DynamicResource ModernScrollViewerStyle}">
                    <ItemsControl x:Name="DependencyGroupsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Border Background="{DynamicResource ColorBrush5}"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="{Binding HeaderText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Dependencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,0,10"
                                                          Cursor="Hand">
                                                    <StackPanel Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                                        <TextBlock Text="{Binding UniqueId}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="84"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Background="Transparent"
                        Foreground="{DynamicResource ColorBrushGray3}"
                        BorderBrush="{DynamicResource ColorBrush3}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="启用所选前置"
                        Width="116"
                        Height="34"
                        Click="Confirm_Click"
                        Background="{DynamicResource ColorBrush2}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>