<Window x:Class="SVL.Desktop.Controls.LocalModDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SVL.Desktop.Controls"
        xmlns:converters="clr-namespace:SVL.Desktop.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource ColorBrush5}"
            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0"
            Width="500"
            MaxHeight="600">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                            BlurRadius="20"
                            ShadowDepth="0"
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ColorBrush2}"
                    CornerRadius="12,12,0,0"
                    Padding="24,20,24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- MOD 名称 -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding ModName}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <!-- 关闭按钮 -->
                    <Button Grid.Column="1"
                            Command="{Binding CloseCommand}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBorder"
                                                    Background="Transparent"
                                                    CornerRadius="16"
                                                    Width="32"
                                                    Height="32"
                                                    Cursor="Hand">
                                                <TextBlock Text="✕"
                                                           FontSize="16"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#40FFFFFF" TargetName="CloseBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20,24,20"
                          Style="{DynamicResource ModernScrollViewerStyle}">
                <StackPanel>

                    <!-- 描述 -->
                    <TextBlock Text="{Binding Description}"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                    <!-- 版本 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="版本："
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Version}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <!-- 作者 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="作者："
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Author}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Author, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </Grid>

                    <!-- 唯一ID -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="唯一ID："
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding UniqueId}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding UniqueId, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </Grid>

                    <!-- 模组名称 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="模组："
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModName}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <!-- MOD路径 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="路径："
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Top"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModPath}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <!-- 状态 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="状态："
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- 已启用/已禁用 -->
                            <Border Background="{Binding IsEnabledBackground}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding IsEnabledText}"
                                           FontSize="11"
                                           Foreground="White"/>
                            </Border>

                            <!-- 可更新 -->
                            <Border Background="{DynamicResource ColorBrush2}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="可更新"
                                           FontSize="11"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 依赖项 -->
                    <TextBlock Text="依赖项："
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding Dependencies}"
                                  Margin="0,0,0,12"
                                  Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenDependencyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="DependencyBorder"
                                                                Background="{DynamicResource ColorBrush5}"
                                                                BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8,6"
                                                                Margin="0,0,0,4">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayText}"
                                                                           FontSize="12"
                                                                           FontWeight="Medium"
                                                                           Foreground="{DynamicResource ColorBrush1}"/>
                                                                <TextBlock Text="{Binding UniqueId, StringFormat=唯一ID: {0}}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource ColorBrushGray3}"
                                                                           Margin="0,2,0,0"
                                                                           Visibility="{Binding UniqueId, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding Note}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource ColorBrushGray3}"
                                                                           Margin="0,2,0,0"
                                                                           Visibility="{Binding Note, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" TargetName="DependencyBorder" Value="{DynamicResource ColorBrush2}"/>
                                                                <Setter Property="Background" TargetName="DependencyBorder" Value="{DynamicResource ColorBrushTransparentBackground}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ColorBrush5}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="24,16,24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="打开文件夹"
                            Command="{Binding OpenFolderCommand}"
                            Height="36"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="返回"
                            Command="{Binding CloseCommand}"
                            Height="36"
                            Padding="24,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
