<UserControl x:Class="SVL.Desktop.Controls.DownloadFloatingButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:DownloadManagerViewModel}"
             d:DesignHeight="60"
             d:DesignWidth="60"
             Visibility="{Binding ShowFloatingButton, Converter={StaticResource BoolToVisibilityConverter}}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>

          <Grid x:Name="RootGrid"
              Width="60"
              Height="60"
              MouseEnter="RootGrid_MouseEnter"
              MouseLeave="RootGrid_MouseLeave">
        <!-- 圆形按钮 -->
        <Button Width="56"
            Height="56"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="FloatingButton_Click"
            Cursor="Hand"
            RenderTransformOrigin="0.5,0.5">
        <Button.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="28"/>
            </Style>
        </Button.Resources>
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="28"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      Opacity="0.3"
                                                      BlurRadius="12"
                                                      ShadowDepth="4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                   To="1.1"
                                                   Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut"
                                                      Amplitude="0.3"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                   To="1.1"
                                                   Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase EasingMode="EaseOut"
                                                      Amplitude="0.3"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                   To="1.0"
                                                   Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                   To="1.0"
                                                   Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>

        <Grid>
            <!-- 下载图标 -->
            <TextBlock Text="📥"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- 任务数量徽章 -->
            <Border Width="20"
                    Height="20"
                    Background="#FF4488"
                    CornerRadius="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-4,-4,0"
                    Visibility="{Binding EntryTaskCount, Converter={StaticResource IntToVisibilityConverter}}">
                <TextBlock Text="{Binding EntryTaskCount}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="0,0,0,2"/>

                <Border.RenderTransform>
                    <TranslateTransform x:Name="BadgeTransform"/>
                </Border.RenderTransform>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="1.0"
                                               To="0.7"
                                               Duration="0:0:1"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </Grid>

        <Button.RenderTransform>
            <ScaleTransform ScaleX="1.0"
                           ScaleY="1.0"/>
        </Button.RenderTransform>
    </Button>

    <Button x:Name="CloseButton"
            Width="16"
            Height="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,0,0"
            FontSize="10"
            Content="✕"
            Click="CloseButton_Click"
            Cursor="Hand"
            Background="#AA111111"
            Foreground="White"
            BorderThickness="0"
            Visibility="Collapsed">
        <Button.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
        </Button.Resources>
        <Button.Style>
            <Style TargetType="Button">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#CCB71C1C"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>
    </Button>
    </Grid>
</UserControl>
