<Window x:Class="SVL.Desktop.Controls.InstanceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择实例"
        Width="440"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Border Width="400"
                Background="{DynamicResource ColorBrushBackground}"
                CornerRadius="8"
                BorderBrush="{DynamicResource ColorBrush3}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.3"
                                  BlurRadius="20"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Row="0"
                           Text="选择实例"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="SubtitleTextBlock"
                           Grid.Row="1"
                           Text="请选择要安装 Mod 的目标实例"
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           Margin="0,0,0,16"/>

                <ListBox x:Name="InstancesListBox"
                         Grid.Row="2"
                         MinHeight="180"
                         MaxHeight="320"
                         Background="{DynamicResource ColorBrushTransparentBackground}"
                         BorderBrush="{DynamicResource ColorBrush3}"
                         BorderThickness="1"
                         Foreground="{DynamicResource ColorBrush1}">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource ModernScrollViewerStyle}"/>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,8">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"/>
                                <TextBlock Text="{Binding DisplayVersion}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding GamePath}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource ColorBrushGray3}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ColorBrush3}"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="确定"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Click="Confirm_Click"
                            Background="{DynamicResource ColorBrush2}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>