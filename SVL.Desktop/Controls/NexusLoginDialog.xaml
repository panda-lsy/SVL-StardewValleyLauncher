<Window x:Class="SVL.Desktop.Controls.NexusLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SVL.Desktop.Converters"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource ColorBrush5}"
            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0"
            Width="500"
            MaxHeight="700">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                            BlurRadius="20"
                            ShadowDepth="0"
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ColorBrush2}"
                    CornerRadius="12,12,0,0"
                    Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🔓" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Nexus Mods 登录"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 关闭按钮 -->
                    <Button Grid.Column="1"
                            Command="{Binding CloseCommand}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBorder"
                                                    Background="Transparent"
                                                    CornerRadius="16"
                                                    Width="32"
                                                    Height="32"
                                                    Cursor="Hand">
                                                <TextBlock Text="✕"
                                                           FontSize="16"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#40FFFFFF" TargetName="CloseBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="32,24,32,24">
                <StackPanel>

                    <!-- Logo和信息 -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                        <TextBlock Text="NEXUS MODS"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="安全登录SVL以访问Nexus Mods的MOD资源"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 状态显示 -->
                    <Border Background="{DynamicResource ColorBrush5}"
                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,20"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 未登录状态 -->
                            <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="🔒 未登录"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="请点击下方按钮登录您的Nexus Mods账户"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- 已登录状态 -->
                            <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="已登录"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush2}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UserName}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding MembershipType}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 登录按钮 -->
                    <Button Content="🔑 登录 Nexus Mods"
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Center"
                            Width="280"
                            Height="40"
                            Margin="0,8,0,0"
                            Padding="16,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 登出按钮 -->
                    <Button Content="🚪 登出"
                            Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Center"
                            Width="280"
                            Height="40"
                            Margin="0,8,0,0"
                            Padding="16,0"
                            FontSize="14"
                            Cursor="Hand"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 状态信息 -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,16,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>

                    <!-- 说明文字 -->
                    <TextBlock Text="登录后您可以：&#x0a;• 下载Nexus Mods上的MOD&#x0a;• 查看MOD详情和更新&#x0a;• 同步您的Nexus Mods账户"
                               FontSize="11"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ColorBrush5}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭"
                            Command="{Binding CloseCommand}"
                            Height="36"
                            Padding="24,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
