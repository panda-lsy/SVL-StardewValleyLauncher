<Window x:Class="SVL.Desktop.Controls.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="正在下载"
        Height="180"
        Width="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Closing="OnWindowClosing">

    <Border Background="#F0F0F0"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20"
            MouseLeftButtonDown="OnBorderMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                            BlurRadius="10"
                            ShadowDepth="0"
                            Opacity="0.3"/>
        </Border.Effect>

        <StackPanel>
            <!-- 标题 -->
            <TextBlock Text="正在下载 ChromeDriver"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0,0,0,20"/>

            <!-- 状态信息 -->
            <TextBlock x:Name="StatusText"
                       Text="正在初始化..."
                       FontSize="13"
                       Foreground="#666666"
                       Margin="0,0,0,15"/>

            <!-- 进度条容器（带取消按钮） -->
            <Grid Height="24" Margin="0,0,0,15">
                <!-- 进度条 -->
                <Border Background="#E0E0E0"
                        CornerRadius="12"
                        Padding="2"
                        Margin="0,0,30,0">
                    <Grid>
                        <!-- 背景进度条 -->
                        <Border Height="20"
                                CornerRadius="10"
                                Background="#CCCCCC"/>

                        <!-- 前景进度条 -->
                        <Border x:Name="ProgressBar"
                                Height="20"
                                CornerRadius="10"
                                Background="#FF9500"
                                HorizontalAlignment="Left"
                                Width="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF9500"
                                                BlurRadius="5"
                                                ShadowDepth="0"
                                                Opacity="0.5"/>
                            </Border.Effect>
                        </Border>

                        <!-- 进度百分比文字 -->
                        <TextBlock x:Name="ProgressText"
                                   Text="0%"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 取消按钮 -->
                <Button x:Name="CancelButton"
                        Content="×"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#666666"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCancelClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="12"
                                                Width="24"
                                                Height="24">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFE0E0"/>
                                    <Setter Property="Foreground" Value="#FF4444"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FFC0C0"/>
                                    <Setter Property="Foreground" Value="#CC0000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 详细信息 -->
            <TextBlock x:Name="DetailText"
                       Text="首次运行可能需要 1-2 分钟，请耐心等待"
                       FontSize="11"
                       Foreground="#888888"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
