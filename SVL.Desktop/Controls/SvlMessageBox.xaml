<Window x:Class="SVL.Desktop.Controls.SvlMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="提示"
        Width="420"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="OnWindowLoaded">

    <!-- 背景遮罩 -->
    <Grid Background="{DynamicResource ColorBrushMask}">
        <Border Width="420"
                Background="{DynamicResource ColorBrushBackground}"
                CornerRadius="8"
                BorderBrush="{DynamicResource ColorBrush3}"
                BorderThickness="1"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.3"
                                  BlurRadius="20"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 图标 + 标题 -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBlock x:Name="IconTextBlock"
                               Text="ℹ"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource ColorBrush2}"/>
                    <TextBlock x:Name="TitleTextBlock"
                               Text="提示"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrush1}"/>
                </StackPanel>

                <!-- 主要内容 -->
                <TextBlock Grid.Row="1"
                           x:Name="MessageTextBlock"
                           Text=""
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           MaxWidth="372"/>

                <!-- 详细信息（可选） -->
                <TextBlock Grid.Row="2"
                           x:Name="DetailTextBlock"
                           Text=""
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray4}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           MaxWidth="372"
                           Visibility="Collapsed"/>

                <!-- 按钮区域 -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <!-- 取消/否按钮 -->
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="Cancel_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource ColorBrushGray3}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ColorBrush3}"
                            Cursor="Hand"
                            Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 确认/OK按钮（主按钮） -->
                    <Button x:Name="OkButton"
                            Content="确定"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Click="Ok_Click"
                            Background="{DynamicResource ColorBrush2}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
