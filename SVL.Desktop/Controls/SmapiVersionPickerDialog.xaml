<Window x:Class="SVL.Desktop.Controls.SmapiVersionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 SMAPI 版本"
        Width="550"
        Height="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ColorBrush1}">
    <Border Background="{DynamicResource ColorBrush5}"
            CornerRadius="8"
            Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="选择要安装的 SMAPI 版本"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush1}"
                       Margin="0,0,0,8"/>

            <!-- 当前版本信息 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock FontSize="13" Foreground="{DynamicResource ColorBrushGray3}">
                    <Run Text="当前版本: "/>
                    <Run x:Name="CurrentVersionRun" Text="检测中..."/>
                </TextBlock>
            </StackPanel>

            <!-- 源选择 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="下载源: "
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceComboBox"
                          Width="150"
                          Height="28"
                          Margin="8,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="SourceComboBox_SelectionChanged"
                          Background="{DynamicResource ColorBrush5}"
                          Foreground="{DynamicResource ColorBrush1}"
                          BorderBrush="{DynamicResource ColorBrushSemiTransparent}">
                    <ComboBoxItem Content="GitHub" Tag="GitHub"/>
                    <ComboBoxItem Content="NexusMods" Tag="NexusMods"/>
                    <ComboBoxItem Content="CurseForge" Tag="CurseForge"/>
                </ComboBox>
                <TextBlock x:Name="LoadingText"
                           Text="正在加载..."
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 版本列表 -->
            <Border Grid.Row="3"
                    Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,12">
                <Grid>
                    <!-- 加载中动画 -->
                    <StackPanel x:Name="LoadingPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="正在获取 SMAPI 版本列表..."
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorBrushGray3}"/>
                    </StackPanel>

                    <!-- 版本列表 -->
                    <ListView x:Name="VersionsListView"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                        Background="Transparent"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                <Run Text="SMAPI " Foreground="{DynamicResource ColorBrush1}"/>
                                                <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource ColorBrush3}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ColorBrushGray3}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Source, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    Padding="0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" TargetName="Bd"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="Bd"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!-- 翻页控制 -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                <Button x:Name="PrevPageButton"
                        Content="◀ 上一页"
                        Width="80"
                        Height="28"
                        Margin="0,0,8,0"
                        Click="PrevPage_Click"
                        IsEnabled="False"
                        Background="{DynamicResource ColorBrush5}"
                        Foreground="{DynamicResource ColorBrush1}"
                        BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                        BorderThickness="1"
                        Cursor="Hand"/>
                <TextBlock x:Name="PageInfoText"
                           Text="第 1 页"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           VerticalAlignment="Center"
                           Margin="8,0"/>
                <Button x:Name="NextPageButton"
                        Content="下一页 ▶"
                        Width="80"
                        Height="28"
                        Margin="8,0,0,0"
                        Click="NextPage_Click"
                        IsEnabled="False"
                        Background="{DynamicResource ColorBrush5}"
                        Foreground="{DynamicResource ColorBrush1}"
                        BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </StackPanel>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="InstallButton"
                        Content="安装"
                        Width="80"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="Install_Click"
                        IsEnabled="False"
                        Background="{DynamicResource ColorBrush2}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="取消"
                        Width="80"
                        Height="32"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Background="{DynamicResource ColorBrush5}"
                        Foreground="{DynamicResource ColorBrush1}"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
