<Window x:Class="SVL.Desktop.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="确认"
        Width="400"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="OnWindowLoaded">

    <!-- 背景遮罩 -->
    <Grid Background="{DynamicResource ColorBrushMask}">
        <Border Width="400"
                Background="{DynamicResource ColorBrushBackground}"
                CornerRadius="8"
                BorderBrush="{DynamicResource ColorBrush3}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.3"
                                  BlurRadius="20"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           x:Name="TitleTextBlock"
                           Text="确认"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,12"/>

                <!-- 内容 -->
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="MessageTextBlock"
                               Text=""
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- 额外信息（可选） -->
                    <TextBlock x:Name="DetailTextBlock"
                               Text=""
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- 按钮 -->
                <StackPanel Grid.Row="2"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Margin="0,16,0,0">
                    <!-- 否按钮（默认左侧） -->
                    <Button x:Name="NoButton"
                            Content="否"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="No_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource ColorBrushGray3}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ColorBrush3}"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 是按钮（默认右侧，主按钮） -->
                    <Button x:Name="YesButton"
                            Content="是"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Click="Yes_Click"
                            Background="{DynamicResource ColorBrush2}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
