<UserControl x:Class="SVL.Desktop.Views.DownloadRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModel:DownloadRightViewModel}">

    <UserControl.Resources>
        <!-- Value Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:ExpandButtonLabelConverter x:Key="ExpandButtonLabelConverter"/>

        <!-- 自定义滚动条样式 -->
        <Style x:Key="ModernScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Margin="0">
                                <Track.Thumb>
                                    <Thumb MinWidth="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ColorBrushGray3}"
                                                        CornerRadius="4"
                                                        Margin="2,0,2,0"
                                                        Width="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}"/>
                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       Style="{StaticResource ModernScrollBarStyle}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource ColorBrush5}"
                Padding="16,12"
                Margin="0,0,0,16"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- SMAPI 搜索区域（仅在 SMAPI 类别显示） -->
        <controls:MyCard Grid.Row="1" Title="搜索 SMAPI" Margin="0,0,0,16"
                 Visibility="{Binding IsSmapiCategory, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 搜索名称 -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SmapiSearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             Padding="8,6"
                             Margin="0,0,8,0"
                             Background="{DynamicResource ColorBrushTransparentBackground}"
                             Foreground="{DynamicResource ColorBrush1}"
                             BorderBrush="{DynamicResource ColorBrush3}"
                             BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- 搜索按钮 -->
                    <Button Grid.Column="1"
                            Content="搜索"
                            Width="60"
                            FontSize="12"
                            Padding="8,6"
                            Command="{Binding SearchSmapiCommand}"
                            Background="{DynamicResource ColorBrush2}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 来源选择 -->
                <TextBlock Text="来源"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           Margin="0,12,0,4" />
                <ComboBox ItemsSource="{Binding SmapiSources}"
                          SelectedItem="{Binding SmapiSelectedSource}"
                          Style="{StaticResource SettingComboBoxStyle}"
                          FontSize="12"
                          Padding="8,6"
                          Margin="0,0,0,8"
                          Background="{DynamicResource ColorBrushTransparentBackground}"
                          BorderBrush="{DynamicResource ColorBrush3}"/>
            </StackPanel>
        </controls:MyCard>

        <!-- 游戏路径状态提示 -->
        <Border Grid.Row="2"
                Background="{DynamicResource ColorBrush5}"
                Padding="16,12"
                Margin="0,0,0,16"
                CornerRadius="6"
            Visibility="{Binding SmapiGamePathWarningVisibility}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="⚠️ 未设置游戏安装目录"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFA500"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="安装 SMAPI 之前需要先选择 Stardew Valley 游戏的安装目录（包含 Stardew Valley.exe 的文件夹）"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="选择目录"
                            Width="80"
                            Height="32"
                            FontSize="12"
                            Margin="16,0,0,0"
                            Command="{Binding SelectGamePathCommand}"
                            Background="{DynamicResource ColorBrush2}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 内容列表 -->
        <ScrollViewer Grid.Row="3"
                      Style="{StaticResource ModernScrollViewerStyle}"
                      Background="Transparent"
                      Focusable="True"
                      IsHitTestVisible="True">
            <Grid>
                <!-- SMAPI：使用 ModSearch 风格列表 -->
                <controls:ModSearchListControl ItemsSource="{Binding SmapiModList}"
                                               DetailsCommand="{Binding OpenSmapiDetailsCommand}"
                                               ShowDetailsButton="True"
                                               Visibility="{Binding IsSmapiCategory, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 其他分类：保持原 DownloadItem 列表 -->
                <ItemsControl ItemsSource="{Binding FilteredItems}"
                              Visibility="{Binding IsSmapiCategory, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModel:DownloadItem">
                        <controls:MyCard Margin="0,0,0,12">
                            <StackPanel>
                                <!-- 主项目行 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 缩略图 -->
                                    <Border Grid.Column="0"
                                            Width="60"
                                            Height="60"
                                            Background="{DynamicResource ColorBrush5}"
                                            CornerRadius="6"
                                            Margin="0,0,12,0"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.ToggleItemExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}"
                                                         MouseAction="LeftClick" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <!-- Emoji 文本图标 -->
                                            <TextBlock Text="{Binding Thumbnail}"
                                                       FontSize="28"
                                                       Foreground="{DynamicResource ColorBrush1}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NonUrlToVisibilityConverter}}" />
                                            <!-- 图片 URL 图标 -->
                                            <Image Source="{Binding Thumbnail}"
                                                   Width="60"
                                                   Height="60"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding Thumbnail, Converter={StaticResource UrlToVisibilityConverter}}">
                                                <Image.Effect>
                                                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="4" Direction="270" ShadowDepth="2" />
                                                </Image.Effect>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <!-- 信息 -->
                                    <StackPanel Grid.Column="1" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.ToggleItemExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}"
                                                         MouseAction="LeftClick" />
                                        </StackPanel.InputBindings>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ColorBrush1}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Author}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Version}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ColorBrush2}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"
                                                   MaxHeight="54"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 展开/下载按钮 -->
                                    <Button Grid.Column="2"
                                            Content="{Binding IsExpanded, Converter={StaticResource ExpandButtonLabelConverter}}"
                                            Width="80"
                                            Height="36"
                                            Margin="12,0,0,0"
                                            FontSize="13"
                                            Command="{Binding DataContext.ToggleItemExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush1}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 版本列表（可展开） -->
                                <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                              Background="Transparent"
                                              Focusable="False"
                                              MaxHeight="220"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="viewModel:DownloadItem">
                                            <Border Background="{DynamicResource ColorBrush5}"
                                                    Padding="12,8"
                                                    Margin="0,0,0,8"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Version}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorBrush1}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="下载并安装"
                                                            Width="90"
                                                            Height="32"
                                                            FontSize="12"
                                                            Command="{Binding DataContext.DownloadItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Cursor" Value="Hand" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush1}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 翻页按钮 -->
                                    <StackPanel Margin="0,12,0,0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- 上一页按钮 -->
                                        <Button Content="上一页"
                                                Width="70"
                                                Height="32"
                                                Margin="0,0,8,0"
                                                FontSize="12"
                                                Command="{Binding DataContext.PreviousPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.HasPreviousPage, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 页码按钮列表 -->
                                        <ItemsControl ItemsSource="{Binding DataContext.PageNumbers, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- 省略号 (-1) -->
                                                        <TextBlock Text="..."
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   Visibility="{Binding ., Converter={StaticResource NegativeIntToCollapsedConverter}}" />

                                                        <!-- 页码按钮 -->
                                                        <Button Content="{Binding .}"
                                                                Width="36"
                                                                Height="32"
                                                                Margin="2,0"
                                                                FontSize="12"
                                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding .}"
                                                                Visibility="{Binding ., Converter={StaticResource PositiveIntToCollapsedConverter}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorBrushGray5}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="4"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <!-- 当前页高亮 -->
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource PageNumberToBoolConverter}">
                                                                                    <Binding Path="." />
                                                                                    <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 下一页按钮 -->
                                        <Button Content="下一页"
                                                Width="70"
                                                Height="32"
                                                Margin="8,0,0,0"
                                                FontSize="12"
                                                Command="{Binding DataContext.NextPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.HasNextPage, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                        </controls:MyCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
