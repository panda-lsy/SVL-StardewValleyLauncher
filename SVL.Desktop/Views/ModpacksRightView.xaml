<UserControl x:Class="SVL.Desktop.Views.ModpacksRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModel:ModpacksRightViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Status}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,16" />

            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Modpack 功能"
                               Style="{StaticResource ModernSubtitle}"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource ModernBody}"
                               TextWrapping="Wrap"
                               LineHeight="24" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="操作"
                               Style="{StaticResource ModernSubtitle}"
                               Margin="0,0,0,12" />
                    <Button Content="创建 Modpack"
                            Command="{Binding CreateModpackCommand}"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,0,12" />
                    <Button Content="导入 Modpack"
                            Command="{Binding ImportModpackCommand}"
                            Style="{StaticResource ModernButton}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
