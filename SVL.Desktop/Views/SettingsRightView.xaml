<UserControl x:Class="SVL.Desktop.Views.SettingsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModel:SettingsRightViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="设置"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ColorBrush2}"
                       Margin="0,0,0,20" />

            <controls:MyCard Title="关于 SVL" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="应用名称"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="Stardew Valley Launcher"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="版本"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="1.0.0"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="架构"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="基于 PCL2-CE 架构"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </controls:MyCard>

            <controls:MyCard Title="系统信息" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行时"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text=".NET 8.0"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="UI 框架"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="WPF"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="架构模式"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="MVVM (CommunityToolkit.Mvvm)"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="生命周期"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="PCL2-CE 架构"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </controls:MyCard>

            <controls:MyCard Title="功能特性" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="• 实例管理"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="• Mod 安装和管理"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="• NexusMods 集成"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="• Modpack 支持"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="• SMAPI 自动安装"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </controls:MyCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
