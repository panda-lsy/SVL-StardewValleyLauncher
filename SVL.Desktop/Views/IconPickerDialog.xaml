<Window x:Class="SVL.Desktop.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SVL.Desktop.Converters"
        Title="选择图标"
        Width="500"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ColorBrushBackground}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="选择实例图标"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ColorBrush1}"
                   Margin="0,0,0,20"/>

        <!-- 图标网格 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AvailableIcons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Width="80"
                                Height="80"
                                Margin="8"
                                Padding="0"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{DynamicResource ColorBrush5}"
                                                        BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                        BorderThickness="2"
                                                        CornerRadius="8"
                                                        Padding="12">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000"
                                                                        BlurRadius="8"
                                                                        ShadowDepth="0"
                                                                        Opacity="0.1"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <!-- 自定义图标显示 + 号 -->
                                                        <TextBlock Text="+"
                                                                   FontSize="32"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource ColorBrush1}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <!-- 预定义图标 -->
                                                        <Image Source="{Binding IconPath}"
                                                               Stretch="Uniform"
                                                               Width="48"
                                                               Height="48"
                                                               Visibility="{Binding IsCustom, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" TargetName="ButtonBorder"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="取消"
                    Width="80"
                    Height="32"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource ColorBrush5}"
                    Foreground="{DynamicResource ColorBrush1}"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
