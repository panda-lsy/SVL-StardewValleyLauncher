<UserControl x:Class="SVL.Desktop.Views.VersionSettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             xmlns:views="clr-namespace:SVL.Desktop.Views"
             xmlns:viewmodels="clr-namespace:SVL.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <converters:TypeToVisibilityConverter x:Key="TypeToVisibilityConverter"/>

        <!-- 自定义滚动条样式 -->
        <Style x:Key="ModernScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Margin="0">
                                <Track.Thumb>
                                    <Thumb MinWidth="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ColorBrushGray3}"
                                                        CornerRadius="4"
                                                        Margin="2,0,2,0"
                                                        Width="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}"/>
                            <ScrollBar Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       Style="{StaticResource ModernScrollBarStyle}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧：游戏路径列表 -->
            <ColumnDefinition Width="280"/>
            <!-- 分隔线 -->
            <ColumnDefinition Width="1"/>
            <!-- 右侧：设置内容 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧面板 -->
        <Border Grid.Column="0"
                Background="{DynamicResource ColorBrushTransparentBackground}"
                BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource ColorBrush5}"
                        CornerRadius="8"
                        Margin="12,12,12,8"
                        Padding="16,12">
                    <TextBlock Text="版本设置"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 导航按钮列表 -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         Margin="8,4,8,8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="8"
                                                Margin="4,2,4,2"
                                                Padding="0"
                                                Cursor="Hand"
                                                Height="44"
                                                TextElement.Foreground="{DynamicResource ColorBrush1}">
                                            <Grid>
                                                <!-- 左侧选中指示条 -->
                                                <Border x:Name="SelectionIndicator"
                                                        Width="4"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        CornerRadius="2"
                                                        Margin="4,8,0,8"/>
                                                <ContentPresenter Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ItemBorder"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ItemBorder"/>
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush1}" TargetName="SelectionIndicator"/>
                                                <Setter Property="TextElement.Foreground" Value="White" TargetName="ItemBorder"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0,16,0"
                                        Height="44">
                                <TextBlock x:Name="NavIcon"
                                           Text="{Binding Icon}"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock x:Name="NavText"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部信息 -->
                <Border Grid.Row="2"
                        Background="{DynamicResource ColorBrush5}"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="12,0,12,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                        BlurRadius="8"
                                        ShadowDepth="0"
                                        Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentInstance.Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}"/>
                        <TextBlock Text="{Binding CurrentInstance.Version, StringFormat=版本: {0}}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 分隔线 -->
        <Border Grid.Column="1"
                Background="{DynamicResource ColorBrushSemiTransparent}"
                Margin="0,16"/>

        <!-- 右侧面板：设置内容 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 浮动操作卡片 - 固定在窗口右下角 -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999"
                Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ModManage}">
                <!-- 外层Border：检查是否为MOD管理页面 -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        BorderThickness="0"
                        Background="Transparent"
                        Panel.ZIndex="9999"
                        Margin="16,0,16,20"
                    Visibility="Visible">
                    <!-- 内层Border：检查是否有选中项，并显示浮动卡片 -->
                    <Border Background="{DynamicResource ColorBrush2}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="20"
                            Visibility="{Binding RightContent.ShowSelectionActions, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                        BlurRadius="16"
                                        ShadowDepth="0"
                                        Opacity="0.3"/>
                    </Border.Effect>
                    <Grid MaxWidth="980"
                          MinWidth="420">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding RightContent.SelectedCount, StringFormat=已选择 {0} 个文件}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding RightContent.BackupSelectedCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    Visibility="{Binding RightContent.IsBackupFilterActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="备份已选" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.BatchBindSelectedTagsToSelectedModsCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    IsEnabled="{Binding RightContent.CanBatchAddSelectedTags}"
                                    Visibility="{Binding RightContent.CanBatchAddSelectedTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="添加标签" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.BatchUnbindSelectedTagsFromSelectedModsCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    IsEnabled="{Binding RightContent.CanBatchRemoveSelectedTags}"
                                    Visibility="{Binding RightContent.CanBatchRemoveSelectedTags, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="删除标签" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.UpdateSelectedCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    Visibility="{Binding RightContent.HasSelectedUpdatable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="更新" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.RefreshSelectedLocalizationCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    Visibility="{Binding RightContent.HasSelectedLocalizableMods, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="汉化" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.UpdateSelectedCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    Visibility="{Binding RightContent.IsBackupFilterActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="替换" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.EnableSelectedCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    Visibility="{Binding RightContent.IsBackupFilterActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="启用" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.DisableSelectedCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    Visibility="{Binding RightContent.IsBackupFilterActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="禁用" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.DeleteSelectedCommand}"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Padding="16,0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E53935"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C62828" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="删除" FontSize="14" VerticalAlignment="Center"/>
                            </Button>

                            <Button Command="{Binding RightContent.CancelSelectionCommand}"
                                    Height="36"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    Content="取消选择">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="White" TargetName="ButtonBorder"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- 关闭外层Border -->
                </Border>
            </Grid>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ColorBrush5}"
                    Padding="16,12"
                    Margin="20,20,20,0">
                <Grid>
                    <!-- 左侧标题 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="配置选项"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}"/>
                        <TextBlock Text="{Binding CurrentInstance.Name, StringFormat=' - {0}'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <!-- 右侧状态消息 -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush2}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource ModernScrollViewerStyle}"
                          Background="Transparent"
                          Focusable="True"
                          IsHitTestVisible="True"
                          Margin="20,16,20,84">
                <ContentControl Content="{Binding RightContent}">
                    <ContentControl.Resources>
                        <!-- 概览页面 -->
                        <DataTemplate DataType="{x:Type viewmodels:VersionSettingsRightViewModel}">
                            <views:VersionSettingsContentView/>
                        </DataTemplate>
                        <!-- 设置页面 -->
                        <DataTemplate DataType="{x:Type viewmodels:InstanceSettingsViewModel}">
                            <views:InstanceSettingsView/>
                        </DataTemplate>
                        <!-- 导出页面 -->
                        <DataTemplate DataType="{x:Type viewmodels:ExportViewModel}">
                            <views:ExportView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
