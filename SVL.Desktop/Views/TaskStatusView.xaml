<UserControl x:Class="SVL.Desktop.Views.TaskStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModel:TaskStatusViewModel}">
    <Grid Background="{DynamicResource ColorBrushBackground}">
        <!-- 主要内容区域 - 左右分栏 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 右侧内容区域 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource ModernScrollViewerStyle}">
                <StackPanel Margin="20,32,40,40">
                    <!-- 失败状态内容 -->
                    <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- 失败原因卡片 -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="失败原因"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="18"
                                           Foreground="{DynamicResource ColorBrushGray2}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           LineHeight="26"/>
                            </StackPanel>
                        </Border>

                        <!-- 详细信息卡片 -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="详细信息"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{Binding DetailMessage}"
                                           FontSize="15"
                                           Foreground="{DynamicResource ColorBrushGray1}"
                                           TextWrapping="Wrap"
                                           LineHeight="22"/>
                            </StackPanel>
                        </Border>

                        <!-- 内部错误卡片（如果有） -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasInnerError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="内部错误"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{Binding InnerErrorMessage}"
                                           FontSize="14"
                                           Foreground="{DynamicResource ColorBrushGray2}"
                                           TextWrapping="Wrap"
                                           LineHeight="22"/>
                            </StackPanel>
                        </Border>

                        <!-- 建议操作卡片 -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding AdviceTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Margin="0,0,0,16"/>
                                <ItemsControl ItemsSource="{Binding SuggestedActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=• {0}}"
                                                       FontSize="15"
                                                       Foreground="#2D2D2D"
                                                       Margin="0,0,0,12"
                                                       LineHeight="22"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 技术信息卡片 -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="技术信息"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Margin="0,0,0,12"/>

                                <StackPanel>
                                    <TextBlock Text="任务类型：SMAPI 安装"
                                               FontSize="14"
                                               Foreground="{DynamicResource ColorBrushGray1}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="错误类型：下载/安装失败"
                                               FontSize="14"
                                               Foreground="{DynamicResource ColorBrushGray1}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="日志位置：%LocalAppData%\SVL\logs\"
                                               FontSize="14"
                                               Foreground="{DynamicResource ColorBrushGray1}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 进行中状态内容 -->
                    <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <!-- 进度卡片 -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="当前状态"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="{Binding StatusMessage}"
                                           FontSize="15"
                                           Foreground="{DynamicResource ColorBrushGray1}"
                                           TextWrapping="Wrap"
                                           LineHeight="24"
                                           Margin="0,0,0,16"/>

                                <!-- 进度条 -->
                                <Grid Height="8" x:Name="ProgressGrid">
                                    <Border Background="#E0E0E0"
                                            CornerRadius="4"/>
                                    <Border Background="{DynamicResource ColorBrush2}"
                                            CornerRadius="4"
                                            HorizontalAlignment="Left">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                <Binding Path="Progress" Mode="OneWay"/>
                                                <Binding ElementName="ProgressGrid" Path="ActualWidth"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>

                                <!-- 进度详情（主题色文字） -->
                                <TextBlock Text="{Binding ProgressDetail}"
                                           FontSize="15"
                                           Foreground="{DynamicResource ColorBrushGray2}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 提示信息 Card -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <!-- 普通任务的提示 -->
                                <StackPanel Visibility="{Binding IsCollectionWizardTask, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AdviceTitle}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,12"/>

                                    <ItemsControl ItemsSource="{Binding SuggestedActions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=• {0}}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource ColorBrushGray1}"
                                                           Margin="0,0,0,12"
                                                           LineHeight="22"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Collection Wizard / 批量更新的提示 -->
                                <StackPanel Visibility="{Binding IsShowModListTask, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="提示"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,12"/>

                                    <TextBlock FontSize="14"
                                               Foreground="{DynamicResource ColorBrushGray1}"
                                               TextWrapping="Wrap"
                                               LineHeight="22">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding BatchUpdateHintText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollectionWizardTask}" Value="True">
                                                        <Setter Property="Text" Value="{Binding WizardHintText}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBrowserDownloadTask}" Value="True">
                                                        <Setter Property="Text" Value="{Binding WizardHintText}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSvlModpackTask}" Value="True">
                                                        <Setter Property="Text" Value="{Binding WizardHintText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Collection Wizard / 批量更新 特殊内容 -->
                    <StackPanel Visibility="{Binding IsShowModListTask, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                        <!-- 当前 Mod 信息卡片 -->
                        <Border Background="{DynamicResource ColorBrush2}"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16"
                                Visibility="{Binding ShowCurrentModCard, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="当前需要下载"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               Margin="0,0,0,8"/>
                                    <TextBlock FontSize="16"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding CurrentBatchUpdateModName}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollectionWizardTask}" Value="True">
                                                        <Setter Property="Text" Value="{Binding CurrentWizardModName}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBrowserDownloadTask}" Value="True">
                                                        <Setter Property="Text" Value="{Binding CurrentWizardModName}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSvlModpackTask}" Value="True">
                                                        <Setter Property="Text" Value="{Binding CurrentWizardModName}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Collection Wizard 的跳过按钮 -->
                                    <Button Content="⊘ 跳过"
                                            Padding="12,8"
                                            Margin="0,0,8,0"
                                            Command="{Binding SkipWizardModCommand}"
                                            IsEnabled="{Binding IsWizardWaitingConfirmation}"
                                            Cursor="Hand"
                                            Visibility="{Binding IsCollectionWizardTask, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 批量更新的「跳过」按钮 -->
                                    <Button Content="跳过"
                                            Padding="12,8"
                                            Margin="0,0,8,0"
                                            Command="{Binding BatchUpdateSkipModCommand}"
                                            IsEnabled="{Binding IsBatchUpdateWaitingConfirmation}"
                                            Cursor="Hand"
                                            Visibility="{Binding IsBatchUpdateTask, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush1}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="🌐 打开浏览器"
                                            Padding="12,8"
                                            Command="{Binding OpenBrowserForWizardModCommand}"
                                            IsEnabled="{Binding IsWizardWaitingConfirmation}"
                                            Cursor="Hand"
                                            Visibility="{Binding IsCollectionWizardTask, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush1}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="🌐 打开浏览器"
                                            Padding="12,8"
                                            Command="{Binding OpenBrowserForBatchUpdateModCommand}"
                                            IsEnabled="{Binding ShowBatchUpdateBrowserButton}"
                                            Cursor="Hand"
                                            Visibility="{Binding ShowBatchUpdateBrowserButton, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush1}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- SVL 整合包的「打开浏览器」按钮 -->
                                    <Button Content="🌐 打开浏览器"
                                            Padding="12,8"
                                            Command="{Binding OpenBrowserForWizardModCommand}"
                                            IsEnabled="{Binding IsWizardWaitingConfirmation}"
                                            Cursor="Hand"
                                            Visibility="{Binding IsSvlModpackTask, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush1}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- NexusMods 浏览器下载的「重新打开浏览器」按钮 -->
                                    <Button Content="🌐 重新打开浏览器"
                                            Padding="12,8"
                                            Command="{Binding OpenBrowserForWizardModCommand}"
                                            IsEnabled="{Binding IsWizardWaitingConfirmation}"
                                            Cursor="Hand"
                                            Visibility="{Binding IsBrowserDownloadTask, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush1}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mod 列表卡片 -->
                        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                                CornerRadius="12"
                                Padding="20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowModListCard}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowBatchUpdateModListCard}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Mod 列表"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           Margin="0,0,0,12"/>

                                <!-- 统一表头 -->
                                <Grid Grid.Row="1" Height="32"
                                      Background="{DynamicResource ColorBrush2}"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- # - 公共 -->
                                    <TextBlock Grid.Column="0"
                                               Text="#"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <!-- 阶段 - 仅 Collection Wizard -->
                                    <TextBlock Grid.Column="1"
                                               Text="阶段"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCollectionWizardTask, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Mod 名称 - 公共 -->
                                    <TextBlock Grid.Column="2"
                                               Text="Mod 名称"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>

                                    <!-- 大小 - 仅 Collection Wizard -->
                                    <TextBlock Grid.Column="3"
                                               Text="大小"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCollectionWizardTask, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- 当前版本 - 仅批量更新 -->
                                    <TextBlock Grid.Column="4"
                                               Text="当前版本"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsBatchUpdateTask, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- 最新版本 - 仅批量更新 -->
                                    <TextBlock Grid.Column="5"
                                               Text="最新版本"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsBatchUpdateTask, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- 来源 - 仅批量更新 -->
                                    <TextBlock Grid.Column="6"
                                               Text="来源"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsBatchUpdateTask, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Width="60"/>

                                    <!-- 状态 - 公共 (位置根据任务类型不同) -->
                                    <TextBlock Grid.Column="4"
                                               Text="状态"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCollectionWizardTask, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <!-- Mod 列表（使用 ScrollViewer 以支持长列表，高度动态计算） -->
                                <ScrollViewer Grid.Row="2"
                                              MaxHeight="{Binding WizardModListScrollViewerHeight}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Style="{StaticResource ModernScrollViewerStyle}">
                                    <!-- 统一 Mod 列表 -->
                                    <ItemsControl ItemsSource="{Binding ModListItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ColorBrushBackground}"
                                                        Padding="12,8"
                                                        Margin="0,0,0,4"
                                                        CornerRadius="4"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- # - 公共 -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Index}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- 阶段 - 仅 Collection Wizard -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Phase}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsCollectionWizardTask, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <!-- Mod 名称 - 公共 -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ColorBrush1}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- 大小 - 仅 Collection Wizard -->
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding FileSize}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsCollectionWizardTask, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <!-- 当前版本 - 仅批量更新 -->
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding CurrentVersion}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsBatchUpdateTask, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <!-- 最新版本 - 仅批量更新 -->
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding NewVersion}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ColorBrush1}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsBatchUpdateTask, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <!-- 来源 - 仅批量更新 -->
                                                        <TextBlock Grid.Column="6"
                                                                   Text="{Binding Platform}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsBatchUpdateTask, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   Width="60"/>

                                                        <!-- 状态 - 公共 (位置根据任务类型不同) -->
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DataContext.IsCollectionWizardTask, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 翻页控件（独立行） -->
                                <Border Grid.Row="3"
                                        Height="40"
                                        Background="{DynamicResource ColorBrush2}"
                                        CornerRadius="4"
                                        Margin="0,12,0,0"
                                        Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 页面信息 -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding WizardPageInfo}"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>

                                        <!-- 上一页按钮 -->
                                        <Button Grid.Column="0"
                                                Content="◀ 上一页"
                                                Command="{Binding WizardPreviousPageCommand}"
                                                IsEnabled="{Binding CanGoToWizardPreviousPage}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Padding="8,4"
                                                FontSize="11"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#80FFFFFF"/>
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 下一页按钮 -->
                                        <Button Grid.Column="2"
                                                Content="下一页 ▶"
                                                Command="{Binding WizardNextPageCommand}"
                                                IsEnabled="{Binding CanGoToWizardNextPage}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Padding="8,4"
                                                FontSize="11"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#80FFFFFF"/>
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 左侧边栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ColorBrushTransparentBackground}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding StatusIcon}"
                                   FontSize="42"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{Binding StatusColor}"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TaskName}"
                                   FontSize="12"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="16"
                                   MaxWidth="200"/>
                    </StackPanel>

                    <!-- 任务列表区域（当有多个任务时显示） -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource ColorBrush5}"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="{Binding ShowTaskList, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 任务列表标题 -->
                            <TextBlock Grid.Row="0"
                                       Text="进行中的任务"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrushGray3}"
                                       Margin="0,0,0,8"/>

                            <!-- 分隔线 -->
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{DynamicResource ColorBrush3}"
                                    Margin="0,0,0,8"/>

                            <!-- 任务列表 -->
                            <ItemsControl Grid.Row="2"
                                          ItemsSource="{Binding ActiveTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                Padding="8,6"
                                                Margin="0,0,0,4"
                                                CornerRadius="4"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"
                                                             MouseAction="LeftClick" />
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 状态图标 -->
                                                <Ellipse Grid.Column="0"
                                                         Width="6"
                                                         Height="6"
                                                         Fill="{DynamicResource ColorBrush2}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>

                                                <!-- 任务信息 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ColorBrush1}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource ColorBrushGray3}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- 帮助信息 -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource ColorBrush2}"
                            CornerRadius="8"
                            Padding="16"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="需要帮助？"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="查看日志文件了解更多详情"
                                       FontSize="11"
                                       Foreground="#F0F0F0"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮（置底，文本和命令根据状态动态变化） -->
                    <Button Grid.Row="3"
                            Content="{Binding ActionButtonText}"
                            Command="{Binding ExecuteActionCommand}"
                            Width="200"
                            Height="36"
                            FontSize="13"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Cursor="Hand"
                            Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#D32F2F" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#B71C1C" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#E0E0E0" />
                                        <Setter Property="Foreground" Value="#9E9E9E" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
