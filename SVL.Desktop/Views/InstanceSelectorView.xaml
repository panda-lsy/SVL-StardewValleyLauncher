<UserControl x:Class="SVL.Desktop.Views.InstanceSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InstanceToIconConverter x:Key="InstanceToIconConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧：游戏路径列表 -->
            <ColumnDefinition Width="280"/>
            <!-- 分隔线 -->
            <ColumnDefinition Width="1"/>
            <!-- 右侧：实例选择 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧面板 -->
        <Border Grid.Column="0"
                Background="{DynamicResource ColorBrushTransparentBackground}"
                BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <TextBlock Grid.Row="0"
                           Text="路径列表"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="16,16,16,8"/>
                
                <!-- 路径列表 -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding PathEntries}"
                         SelectedItem="{Binding SelectedPathEntry}"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="8,8,8,8">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer Style="{DynamicResource ModernScrollViewerStyle}"
                                              Padding="{TemplateBinding Padding}"
                                              Focusable="False">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="重命名"
                                      Command="{Binding RenamePathCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="打开文件夹"
                                      Command="{Binding OpenFolderCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="刷新信息"
                                      Command="{Binding RefreshPathCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="删除"
                                      Command="{Binding DeletePathCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{DynamicResource ColorBrush5}"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="6"
                                                Margin="0,4,0,4"
                                                Padding="12,8"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrushMask}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{DynamicResource ColorBrush2}"
                                                        BorderBrush="{DynamicResource ColorBrush3}"
                                                        BorderThickness="2"
                                                        CornerRadius="6"
                                                        Margin="0,4,0,4"
                                                        Padding="12,8"
                                                        Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 路径名称 -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource ColorBrush1}"/>

                                <!-- 路径 -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding GamePath}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorBrushGray2}"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding GamePath}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- 添加或导入 -->
                <TextBlock Grid.Row="2"
                           Text="添加或导入"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="16,16,16,8"/>
                
                <!-- 操作按钮 -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Margin="16,0,16,8">
                    <Button Content="添加"
                            Width="60"
                            Height="32"
                            FontSize="13"
                            Cursor="Hand"
                            Command="{Binding AddInstanceCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush1}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="导入整合包"
                            Width="100"
                            Height="32"
                            Margin="8,0,0,0"
                            FontSize="13"
                            Cursor="Hand"
                            Command="{Binding ImportModpackCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush1}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush4}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="刷新"
                            Width="60"
                            Height="32"
                            Margin="8,0,0,0"
                            FontSize="13"
                            Cursor="Hand"
                            Command="{Binding RefreshCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush1}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    </StackPanel>

                
                <!-- 底部提示 -->
                <Border Grid.Row="4"
                        Background="{DynamicResource ColorBrush5}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="16,0,16,16">
                    <TextBlock Text="选择或添加游戏路径"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               TextAlignment="Center"
                               Visibility="{Binding HasPathEntries, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 分隔线 -->
        <Border Grid.Column="1"
                Background="{DynamicResource ColorBrushSemiTransparent}"
                Margin="0,16"/>

        <!-- 右侧面板 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ColorBrush5}"
                    Padding="16,12"
                    Margin="20,20,20,0">
                <TextBlock Text="选择启动版本"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"/>
            </Border>

            <!-- 实例选择内容 -->
            <ScrollViewer Grid.Row="1"
                          Style="{DynamicResource ModernScrollViewerStyle}"
                          Margin="20,16,20,20">
                <StackPanel>
                    <!-- 未选择路径时的提示 -->
                    <StackPanel Visibility="{Binding SelectedPathEntry, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,40,0,0">
                        <TextBlock Text="请从左侧选择一个游戏路径"
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="点击路径后，右侧将显示该路径下的所有可用版本"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 实例列表 -->
                    <ItemsControl ItemsSource="{Binding SelectedPathInstances}"
                                 Visibility="{Binding SelectedPathEntry, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 实例卡片 -->
                                <Button Command="{Binding DataContext.SelectInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        Margin="0,0,0,12"
                                        Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder"
                                                    Background="{DynamicResource ColorBrushTransparentBackground}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000"
                                                                    BlurRadius="8"
                                                                    ShadowDepth="0"
                                                                    Opacity="0.1"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 图标 -->
                                                    <Border Grid.Column="0"
                                                            Width="48"
                                                            Height="48"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource ColorBrushTransparentBackground}"
                                                            Margin="0,0,16,0">
                                                        <Image Source="{Binding Converter={StaticResource InstanceToIconConverter}}"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <!-- 信息 -->
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <!-- 名称和标签 -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ColorBrush1}"/>
                                                            <!-- SMAPI 标签 -->
                                                            <Border Background="{DynamicResource ColorBrush2}"
                                                                    CornerRadius="3"
                                                                    Padding="6,2"
                                                                    Margin="8,0,0,0"
                                                                    Visibility="{Binding IsSMAPIInstance, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="SMAPI"
                                                                           FontSize="10"
                                                                           FontWeight="Medium"
                                                                           Foreground="White"/>
                                                            </Border>
                                                            <!-- 原版标签 -->
                                                            <Border Background="{DynamicResource ColorBrush5}"
                                                                    CornerRadius="3"
                                                                    Padding="6,2"
                                                                    Margin="8,0,0,0"
                                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                                    BorderThickness="1"
                                                                    Visibility="{Binding IsSMAPIInstance, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                                <TextBlock Text="原版"
                                                                           FontSize="10"
                                                                           FontWeight="Medium"
                                                                           Foreground="{DynamicResource ColorBrushGray3}"/>
                                                            </Border>
                                                            <!-- 自定义标签（Base 等） -->
                                                            <ItemsControl ItemsSource="{Binding Tags}"
                                                                          Margin="8,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource ColorBrush3}"
                                                                                CornerRadius="3"
                                                                                Padding="6,2"
                                                                                Margin="4,0,0,0">
                                                                            <TextBlock Text="{Binding}"
                                                                                       FontSize="10"
                                                                                       FontWeight="Medium"
                                                                                       Foreground="White"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <!-- 版本信息 -->
                                                        <TextBlock Text="{Binding DisplayVersion}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"/>
                                                        <!-- SMAPI 版本 -->
                                                        <TextBlock Text="{Binding SMAPIVersion, StringFormat=SMAPI 版本: {0}}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding IsSMAPIInstance, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <!-- 设置按钮 -->
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.OpenVersionSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            Width="40"
                                                            Height="40"
                                                            Margin="0,0,8,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTip="版本设置">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="SettingsBorder"
                                                                        Background="Transparent"
                                                                        CornerRadius="20"
                                                                        Padding="8">
                                                                    <TextBlock x:Name="SettingsIcon"
                                                                               Text="⚙"
                                                                               FontSize="20"
                                                                               Foreground="{DynamicResource ColorBrushGray3}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" TargetName="SettingsBorder"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" TargetName="SettingsIcon"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- 收藏按钮 -->
                                                    <Button Grid.Column="3"
                                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            Width="40"
                                                            Height="40"
                                                            Margin="0,0,8,0"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="FavoriteButton_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="FavoriteBorder"
                                                                        Background="Transparent"
                                                                        CornerRadius="20"
                                                                        Padding="8">
                                                                    <TextBlock x:Name="FavoriteIcon"
                                                                               FontSize="20"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="☆"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray3}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                        <Setter Property="Text" Value="★"/>
                                                                                        <Setter Property="Foreground" Value="#FF8C00"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" TargetName="FavoriteBorder"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <!-- 箭头 -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="→"
                                                               FontSize="20"
                                                               Foreground="{DynamicResource ColorBrush2}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="CardBorder"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" TargetName="CardBorder"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                                               Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.X)"
                                                                               To="4"
                                                                               Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="CardBorder"
                                                                               Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.X)"
                                                                               To="0"
                                                                               Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
