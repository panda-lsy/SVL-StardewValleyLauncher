<UserControl x:Class="SVL.Desktop.Views.ModpacksLeftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="320"
             d:DataContext="{d:DesignInstance Type=viewModel:ModpacksLeftViewModel}">
    <StackPanel Margin="16">
        <TextBlock Text="Modpacks"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,16" />

        <Button Content="创建 Modpack"
                Style="{StaticResource RoundButtonStyle}"
                HorizontalAlignment="Stretch"
                Padding="16" />

        <Button Content="导入 Modpack"
                Style="{StaticResource NavigationButtonStyle}"
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
