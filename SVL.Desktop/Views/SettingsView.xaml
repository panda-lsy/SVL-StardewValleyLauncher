<UserControl x:Class="SVL.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:SVL.Desktop.ViewModels"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance viewmodels:SettingsViewModel}"
             Loaded="OnSettingsViewLoaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Card 样式 -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ColorBrushTransparentBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 标题样式 -->
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 描述样式 -->
        <Style x:Key="SettingDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray3}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- TextBox 样式 -->
        <Style x:Key="SettingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray3}"/>
            <Setter Property="Background" Value="{DynamicResource ColorBrushGray8}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ColorBrush1}"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- PasswordBox 样式（用于 API Key） -->
        <Style x:Key="SettingPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray3}"/>
            <Setter Property="Background" Value="{DynamicResource ColorBrushGray8}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ColorBrush1}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ColorBrush2}"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ComboBox 样式已移至 Resources/ModernStyles.xaml 全局资源 -->

        <!-- CheckBox 样式 -->
        <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ColorBrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <Border Grid.Row="0"
                Background="{DynamicResource ColorBrush5}"
                Padding="24,20"
                BorderThickness="0"
                CornerRadius="8,8,0,0">
            <Grid>
                <TextBlock Text="设置"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ColorBrush1}"/>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrush2}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 标签页和内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧标签页列表 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ColorBrush5}"
                    Padding="0,16">
                <StackPanel>
                    <Button x:Name="TabBasic"
                            Content="基本设置"
                            Click="OnTabClick"
                            Tag="0"
                            Padding="16,12"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource ColorBrush1}"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="TabApi"
                            Content="下载源配置"
                            Click="OnTabClick"
                            Tag="1"
                            Padding="16,12"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource ColorBrush1}"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="TabPersonalization"
                            Content="个性化"
                            Click="OnTabClick"
                            Tag="2"
                            Padding="16,12"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource ColorBrush1}"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="TabOther"
                            Content="其他"
                            Click="OnTabClick"
                            Tag="3"
                            Padding="16,12"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource ColorBrush1}"
                            FontSize="14"
                            Cursor="Hand"/>

                    <Button x:Name="TabAbout"
                            Content="关于"
                            Click="OnTabClick"
                            Tag="4"
                            Padding="16,12"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource ColorBrush1}"
                            FontSize="14"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- 右侧内容区域 -->
            <ScrollViewer Grid.Column="1"
                          Padding="24,24,32,24"
                          VerticalScrollBarVisibility="Auto"
                          Style="{DynamicResource ModernScrollViewerStyle}">
                <StackPanel>

                    <!-- ===== 基本设置 ===== -->
                    <StackPanel x:Name="PanelBasic" Visibility="Visible">
                        <!-- Card 1: 启动选项 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="启动选项"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <!-- 游戏窗口标题 -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="游戏窗口标题"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="400"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding GameWindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingTextBoxStyle}"/>

                                        <!-- 帮助按钮 -->
                                        <Button Grid.Column="1"
                                                Command="{Binding ShowWindowTitleHelpCommand}"
                                                Width="32"
                                                Height="32"
                                                Margin="8,0,0,0"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Content="?"
                                                Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ButtonBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderThickness="0"
                                                                        CornerRadius="16"
                                                                        Width="32"
                                                                        Height="32"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush1}" TargetName="ButtonBorder"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 优先级规则面板 -->
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource ColorBrush2}"
                                                CornerRadius="4"
                                                Padding="12,8"
                                                Margin="12,0,0,0"
                                                MaxWidth="280">
                                            <StackPanel>
                                                <TextBlock Text="ℹ️ 优先级规则"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           Margin="0,0,0,4"/>

                                                <TextBlock FontSize="11"
                                                           Foreground="White"
                                                           LineHeight="16">
                                                    <Run Text="1. 版本设置（当前）"/><LineBreak/>
                                                    <Run Text="2. 全局设置（本页面）"/><LineBreak/>
                                                    <Run Text="3. 默认值（Stardew Valley）"/><LineBreak/>
                                                    <LineBreak/>
                                                    <Run Text="输入 &lt;default&gt; 使用上一优先级"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="设置游戏窗口显示的标题（留空或输入 &lt;default&gt; 使用全局设置）"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <!-- 自定义启动器标题 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="自定义启动器标题"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding LauncherTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingTextBoxStyle}"
                                             Width="400"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="自定义启动器窗口标题"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <!-- 启动器应用名称 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="启动器应用名称"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding LauncherAppName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingTextBoxStyle}"
                                             Width="400"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="显示在左上角 Logo 旁边的文本（需要重启应用生效）"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <!-- 启动器可见性 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="启动器可见性"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding LauncherVisibilityOptions}"
                                              SelectedIndex="{Binding SelectedLauncherVisibilityIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="400"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="游戏启动后启动器的行为"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <!-- 窗口大小模式 -->
                                <StackPanel>
                                    <TextBlock Text="窗口大小"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding WindowSizeModeOptions}"
                                              SelectedIndex="{Binding SelectedWindowSizeModeIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="400"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="游戏窗口的大小模式"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: 存储空间 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="存储空间"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <!-- 第一行：文件缓存圆环图 -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ring: 图片缓存 + 下载文件缓存（外圈） + 搜索缓存来源分布（内圈） -->
                                    <Grid Grid.Column="0" Width="96" Height="96" Margin="0,0,16,0">
                                        <!-- 外圈底图 -->
                                        <Ellipse Stroke="{DynamicResource ColorBrushMask}" StrokeThickness="10"/>
                                        <!-- 内圈底图 -->
                                        <Ellipse Stroke="{DynamicResource ColorBrushMask}" StrokeThickness="6" Width="70" Height="70"/>

                                        <!-- 外圈：图片缓存 -->
                                        <Path Stroke="{DynamicResource ColorBrush2}"
                                              StrokeThickness="10"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource ArcGeometryConverter}" ConverterParameter="38,48">
                                                    <Binding Path="ImageCacheStartAngle"/>
                                                    <Binding Path="ImageCacheSweepAngle"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <!-- 外圈：下载缓存 -->
                                        <Path Stroke="{DynamicResource ColorBrush3}"
                                              StrokeThickness="10"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource ArcGeometryConverter}" ConverterParameter="38,48">
                                                    <Binding Path="DownloadCacheStartAngle"/>
                                                    <Binding Path="DownloadCacheSweepAngle"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <!-- 内圈：NexusMods 搜索缓存 -->
                                        <Path Stroke="{DynamicResource ColorBrush5}"
                                              StrokeThickness="6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource ArcGeometryConverter}" ConverterParameter="26,48">
                                                    <Binding Path="NexusSearchStartAngle"/>
                                                    <Binding Path="NexusSearchSweepAngle"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <!-- 内圈：Curseforge 搜索缓存 -->
                                        <Path Stroke="{DynamicResource ColorBrush6}"
                                              StrokeThickness="6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource ArcGeometryConverter}" ConverterParameter="26,48">
                                                    <Binding Path="CurseforgeSearchStartAngle"/>
                                                    <Binding Path="CurseforgeSearchSweepAngle"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>

                                        <!-- 内圈：GitHub 搜索缓存 -->
                                        <Path Stroke="{DynamicResource ColorBrush7}"
                                              StrokeThickness="6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource ArcGeometryConverter}" ConverterParameter="26,48">
                                                    <Binding Path="GithubSearchStartAngle"/>
                                                    <Binding Path="GithubSearchSweepAngle"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>
                                    </Grid>

                                    <!-- Details: 文件缓存 -->
                                    <StackPanel Grid.Column="1">
                                        <!-- 图片缓存 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border Width="10" Height="10" Background="{DynamicResource ColorBrush2}" CornerRadius="2" Margin="0,2,8,0"/>
                                                    <TextBlock Text="图片缓存" FontSize="13" Foreground="{DynamicResource ColorBrush1}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray3}">
                                                    <Run Text="大小："/>
                                                    <Run Text="{Binding CacheSize}"/>
                                                    <Run Text="，文件："/>
                                                    <Run Text="{Binding ImageCacheCount}"/>
                                                    <Run Text=" 个"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="清理"
                                                    Command="{Binding ClearImageCacheCommand}"
                                                    Width="80"
                                                    Height="32"
                                                    FontSize="12"
                                                    Margin="12,0,0,0"
                                                    IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- 下载文件缓存 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border Width="10" Height="10" Background="{DynamicResource ColorBrush3}" CornerRadius="2" Margin="0,2,8,0"/>
                                                    <TextBlock Text="下载文件缓存" FontSize="13" Foreground="{DynamicResource ColorBrush1}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray3}">
                                                    <Run Text="大小："/>
                                                    <Run Text="{Binding DownloadCacheSize}"/>
                                                    <Run Text="，文件："/>
                                                    <Run Text="{Binding DownloadCacheCount}"/>
                                                    <Run Text=" 个"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="清理"
                                                    Command="{Binding ClearDownloadCacheCommand}"
                                                    Width="80"
                                                    Height="32"
                                                    FontSize="12"
                                                    Margin="12,0,0,0"
                                                    IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- 搜索缓存总览 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="搜索缓存" FontSize="13" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,2"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray3}">
                                                    <Run Text="总计："/>
                                                    <Run Text="{Binding TotalSearchCacheCount}"/>
                                                    <Run Text=" 条"/>
                                                </TextBlock>

                                                <!-- 来源分布 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <Border Width="8" Height="8" Background="{DynamicResource ColorBrush5}" CornerRadius="2" Margin="0,1,6,0"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray3}">
                                                            <Run Text="NexusMods "/>
                                                            <Run Text="{Binding NexusSearchCacheCount}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <Border Width="8" Height="8" Background="{DynamicResource ColorBrush6}" CornerRadius="2" Margin="0,1,6,0"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray3}">
                                                            <Run Text="Curseforge "/>
                                                            <Run Text="{Binding CurseforgeSearchCacheCount}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="8" Height="8" Background="{DynamicResource ColorBrush7}" CornerRadius="2" Margin="0,1,6,0"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray3}">
                                                            <Run Text="GitHub "/>
                                                            <Run Text="{Binding GithubSearchCacheCount}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="清理"
                                                    Command="{Binding ClearSearchCacheCommand}"
                                                    Width="80"
                                                    Height="32"
                                                    FontSize="12"
                                                    Margin="12,0,0,0"
                                                    IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- 缓存设置 -->
                                        <StackPanel Margin="0,10,0,0">
                                            <CheckBox Content="启用搜索记录缓存"
                                                      IsChecked="{Binding EnableNexusModsSearchCache}"
                                                      Style="{StaticResource SettingCheckBoxStyle}"/>
                                            <CheckBox Content="启用下载文件缓存"
                                                      IsChecked="{Binding EnableDownloadCache}"
                                                      Style="{StaticResource SettingCheckBoxStyle}"
                                                      Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 缓存时长 -->
                                <StackPanel Margin="0,20,0,0">
                                    <TextBlock Text="缓存时长" FontSize="13" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding CacheRetentionOptionsText}"
                                              SelectedIndex="{Binding SelectedCacheRetentionIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="200"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="默认 1 小时；过期的搜索缓存会自动清理。"
                                               Style="{StaticResource SettingDescStyle}"/>

                                    <Button Content="清理过期缓存"
                                            Command="{Binding ClearExpiredCacheCommand}"
                                            Width="120"
                                            Height="32"
                                            FontSize="12"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBoolConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== API 设置 ===== -->
                    <StackPanel x:Name="PanelApi" Visibility="Collapsed">
                        <!-- Card 1: 默认下载源设置 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="默认下载源设置"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <!-- SMAPI 默认下载源 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="SMAPI 默认下载源"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding SmapiSources}"
                                              SelectedItem="{Binding SmapiDefaultSource}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Padding="8,6"
                                              Width="300"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="设置 SMAPI 下载页面的默认下载源（可随时在下载页面更改）"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <!-- Mod 默认下载源 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Mod 默认下载源"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ModSources}"
                                              SelectedItem="{Binding ModDefaultSource}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Padding="8,6"
                                              Width="300"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="设置 Mod 搜索页面的默认下载源（可随时在搜索页面更改）"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Curseforge API -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Curseforge API"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="API Key"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <PasswordBox x:Name="CurseforgeApiKeyPasswordBox"
                                                    Grid.Column="0"
                                                    PasswordChar="●"
                                                    Style="{StaticResource SettingPasswordBoxStyle}"
                                                    Width="400"
                                                    HorizontalAlignment="Left"
                                                    PasswordChanged="OnCurseforgeApiKeyPasswordChanged"/>

                                        <Button Grid.Column="1"
                                                Content="测试"
                                                Command="{Binding TestCurseforgeApiCommand}"
                                                Margin="8,0,0,0"
                                                Padding="16,8"
                                                Background="{DynamicResource ColorBrush2}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="13"
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="从 Curseforge 获取你的个人 API Key"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <!-- API 状态 -->
                                <TextBlock x:Name="CurseforgeApiStatusText"
                                           Text="{Binding CurseforgeApiStatus}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorBrush2}"
                                           Visibility="{Binding CurseforgeApiStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- 获取 API Key 按钮 -->
                                <Button Content="🔗 获取 Curseforge API Key"
                                        Padding="12,8"
                                        Margin="0,8,0,0"
                                        Background="{DynamicResource ColorBrush2}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Click="OnGetCurseforgeApiKeyClick">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: NexusMods OAuth -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="NexusMods 账户"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <!-- 未登录状态 -->
                                <StackPanel Visibility="{Binding IsNexusLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="🔒 未登录到 NexusMods"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="SSO 登录（浏览器授权）"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <Button Content="🔑 登录 NexusMods"
                                            Click="OnNexusLoginClick"
                                            Padding="16,10"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ColorBrush2}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="13"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <TextBlock Text="登录后可以：&#x0a;• 下载 NexusMods 上的 Mod&#x0a;• 自动检查 Mod 更新&#x0a;• 同步 Mod 订阅"
                                               FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 已登录状态 -->
                                <StackPanel Visibility="{Binding IsNexusLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding NexusLoginStatusText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF4CAF50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNexusLoginExpired}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFC107"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 用户信息 -->
                                    <Border Background="{DynamicResource ColorBrushGray8}"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 头像 -->
                                            <Ellipse Grid.Column="0"
                                                     Width="48"
                                                     Height="48"
                                                     Margin="0,0,12,0"
                                                     Stroke="{DynamicResource ColorBrush3}"
                                                     StrokeThickness="1">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding NexusAvatarUrl}"
                                                                   Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                                <!-- 如果没有头像，显示默认图标 -->
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NexusAvatarUrl}" Value="{x:Null}">
                                                                <Setter Property="Fill" Value="{DynamicResource ColorBrushGray3}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NexusAvatarUrl}" Value="">
                                                                <Setter Property="Fill" Value="{DynamicResource ColorBrushGray3}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- 用户信息 -->
                                            <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                                <TextBlock Text="{Binding NexusUserName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ColorBrush1}"/>
                                                <TextBlock Text="{Binding NexusMembershipType}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ColorBrush2}"
                                                           Margin="0,4,0,0"/>

                                                <!-- API 统计信息 -->
                                                <TextBlock Text="API 统计"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ColorBrushGray3}"
                                                           Margin="0,8,0,4"/>
                                                <StackPanel Orientation="Horizontal" Margin="0">
                                                    <TextBlock Text="每日请求:"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ColorBrushGray4}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NexusDailyRequests}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ColorBrush2}"
                                                               Margin="4,0,12,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="每小时请求:"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ColorBrushGray4}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding NexusHourlyRequests}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ColorBrush2}"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 登出按钮 -->
                                        <Button Content="{Binding NexusLoginActionText}"
                                            Click="OnNexusLogoutClick"
                                            Padding="16,8"
                                            Width="100"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ColorBrushGray3}"
                                            Foreground="{DynamicResource ColorBrush1}"
                                            FontSize="13"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: NXM 协议注册 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="NXM 协议"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <TextBlock Text="NXM 协议允许您从浏览器直接启动下载。"
                                           Style="{StaticResource SettingDescStyle}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="重新注册 NXM 协议"
                                            Click="OnRegisterNxmProtocolClick"
                                            Padding="16,10"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ColorBrush2}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="13"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <TextBlock Text="{Binding NxmProtocolStatus}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== 个性化 ===== -->
                    <StackPanel x:Name="PanelPersonalization" Visibility="Collapsed">
                        <!-- Card 1: 主题风格 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="主题风格"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <!-- 主题风格选择 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="风格"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ThemeStyleOptions}"
                                              SelectedIndex="{Binding SelectedThemeStyleIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="300"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="选择启动器的整体视觉风格"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <!-- Material You 配色方案（仅在选择 Material You 时显示） -->
                                <StackPanel Margin="0,0,0,16"
                                            Visibility="{Binding ShowMaterialYouOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="配色方案"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding ColorSchemeItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,10,10"
                                                        Padding="12,8"
                                                        CornerRadius="8"
                                                        Cursor="Hand"
                                                        BorderThickness="2"
                                                        Background="{DynamicResource ColorBrushGray8}">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SelectColorSchemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="24" Height="24"
                                                                 Fill="{Binding PreviewColor}"
                                                                 Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="选择 Material You 风格的配色方案，切换后即时生效"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: 外观 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="外观"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <!-- 主题模式 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="主题模式"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ThemeModeOptions}"
                                              SelectedIndex="{Binding SelectedThemeModeIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="300"
                                              HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- 字体大小 -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="字体大小"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FontSizeOptions}"
                                              SelectedIndex="{Binding SelectedFontSizeIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="150"
                                              HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- 语言 -->
                                <StackPanel>
                                    <TextBlock Text="语言"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                                              SelectedIndex="{Binding SelectedLanguageIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="200"
                                              HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: 效果 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="效果"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <CheckBox Content="启用动画"
                                          IsChecked="{Binding EnableAnimations}"
                                          Style="{StaticResource SettingCheckBoxStyle}"/>

                                <CheckBox Content="启用透明效果"
                                          IsChecked="{Binding EnableTransparency}"
                                          Style="{StaticResource SettingCheckBoxStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== 其他 ===== -->
                    <StackPanel x:Name="PanelOther" Visibility="Collapsed">
                        <!-- Card 1: 托盘 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="系统托盘"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <CheckBox Content="启动时最小化到托盘"
                                          IsChecked="{Binding MinimizeToTrayOnStartup}"
                                          Style="{StaticResource SettingCheckBoxStyle}"/>

                                <CheckBox Content="关闭时最小化到托盘"
                                          IsChecked="{Binding MinimizeToTrayOnClose}"
                                          Style="{StaticResource SettingCheckBoxStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: 通知 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="通知"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <CheckBox Content="显示通知"
                                          IsChecked="{Binding ShowNotifications}"
                                          Style="{StaticResource SettingCheckBoxStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: 高级 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="高级"
                                           Style="{StaticResource SettingTitleStyle}"/>

                                <!-- 日志级别 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="日志级别"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding LogLevelOptions}"
                                              SelectedIndex="{Binding SelectedLogLevelIndex}"
                                              Style="{StaticResource SettingComboBoxStyle}"
                                              Width="200"
                                              HorizontalAlignment="Left"/>
                                    <TextBlock Text="控制日志输出的详细程度"
                                               Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <CheckBox Content="启用调试模式"
                                          IsChecked="{Binding DebugMode}"
                                          Style="{StaticResource SettingCheckBoxStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== 关于 ===== -->
                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <!-- 作者卡片 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 作者图标 -->
                                <Border Grid.Column="0"
                                        Width="56"
                                        Height="56"
                                        CornerRadius="28"
                                        Margin="0,0,16,0"
                                        Background="{DynamicResource ColorBrush7}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,56,56" RadiusX="28" RadiusY="28"/>
                                    </Border.Clip>
                                    <Image Source="/Images/author-icon.png"
                                           Stretch="UniformToFill"
                                           Width="56"
                                           Height="56"/>
                                </Border>

                                <!-- 作者信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="作者"
                                               FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="盛夏de背影"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush1}"/>
                                    <TextBlock Text="mc_shengxia"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 赞助按钮 -->
                                <Button Grid.Column="2"
                                        Padding="16,10"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Command="{Binding SponsorCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="赞助支持" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush7}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 启动器 SVL 卡片 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Junimo 图标 -->
                                <Border Grid.Column="0"
                                        Width="56"
                                        Height="56"
                                        Margin="0,0,16,0"
                                        Background="{DynamicResource ColorBrush3}"
                                        CornerRadius="12">
                                    <Image Source="/Images/Junimo.png"
                                           Stretch="Uniform"
                                           Width="48"
                                           Height="48"/>
                                </Border>

                                <!-- 启动器信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="启动器"
                                               FontSize="12"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Stardew Valley Launcher"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush1}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="版本 "
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ColorBrushGray3}"/>
                                        <TextBlock Text="{Binding AppVersion}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ColorBrush2}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 查看源码按钮 -->
                                <Button Grid.Column="2"
                                        Padding="16,10"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Command="{Binding ViewSourceCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="查看源码" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 启动器更新卡片 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="启动器更新"
                                               Style="{StaticResource SettingTitleStyle}"
                                               Margin="0,0,0,8"/>

                                    <!-- 更新状态 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="当前版本: "
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ColorBrushGray3}"/>
                                        <TextBlock Text="{Binding AppVersion}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ColorBrush2}"/>
                                    </StackPanel>

                                    <!-- 最新版本 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="最新版本: "
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ColorBrushGray3}"/>
                                        <TextBlock Text="{Binding LatestVersion}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ColorBrush2}"/>
                                    </StackPanel>

                                    <!-- 更新源 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="更新源: "
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ColorBrushGray3}"/>
                                        <TextBlock Text="{Binding UpdateSource}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                    </StackPanel>

                                    <!-- 更新状态消息 -->
                                    <TextBlock Text="{Binding UpdateStatusMessage}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ColorBrush2}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 检查更新/查看更新按钮 -->
                                <Button Grid.Column="1"
                                        Padding="16,10"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Command="{Binding ShowUpdateDialogCommand}"
                                        IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UpdateButtonText}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                                    <Setter Property="Background" Value="#FF4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 更新设置卡片 -->
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="更新设置"
                                           Style="{StaticResource SettingTitleStyle}"
                                           Margin="0,0,0,12"/>

                                <!-- 启动时检查更新 -->
                                <CheckBox Content="启动时检查更新"
                                          IsChecked="{Binding AutoCheckUpdates}"
                                          Foreground="{DynamicResource ColorBrush1}"
                                          FontSize="13"
                                          Margin="0,0,0,12"/>
                                <TextBlock Text="应用启动后自动检查是否有新版本（推荐开启）"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           Margin="0,-8,0,12"
                                           TextWrapping="Wrap"/>

                                <!-- 自动下载更新 -->
                                <CheckBox Content="有新版本时自动下载更新"
                                          IsChecked="{Binding AutoDownloadUpdate}"
                                          Foreground="{DynamicResource ColorBrush1}"
                                          FontSize="13"
                                          Margin="0,0,0,12"/>

                                <!-- 显示更新提示 -->
                                <CheckBox Content="有新版本时显示提示"
                                          IsChecked="{Binding ShowUpdateNotification}"
                                          Foreground="{DynamicResource ColorBrush1}"
                                          FontSize="13"
                                          Margin="0,0,0,12"/>

                                <!-- 更新源选择 -->
                                <TextBlock Text="首选更新源"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           Margin="0,0,0,8"/>
                                <ComboBox SelectedIndex="{Binding PreferredUpdateSourceIndex, Mode=TwoWay}"
                                          ItemsSource="{Binding UpdateSourceOptions}"
                                          Style="{StaticResource SettingComboBoxStyle}"
                                          Width="200"
                                          HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource ColorBrush5}"
                Padding="24,16"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="设置会自动保存"
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <Button Content="重置为默认值"
                        Command="{Binding ResetSettingsCommand}"
                        Padding="24,10"
                        Background="Transparent"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource ColorBrushGray3}"
                        Foreground="{DynamicResource ColorBrush1}"
                        FontSize="14"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
