<UserControl x:Class="SVL.Desktop.Views.ModsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModel:ModsRightViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Status}"
                       FontSize="12"
                       Foreground="{DynamicResource ColorBrushGray3}"
                       Margin="0,0,0,16" />

            <controls:MyCard Title="Mod 信息" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ModName}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="版本"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ModVersion}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="作者"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ModAuthor}"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   Grid.Column="1"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="唯一ID"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush4}"
                                   Grid.Column="0"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding ModUniqueId}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   FontFamily="Consolas, Courier New"
                                   Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </controls:MyCard>

            <controls:MyCard Title="描述" Margin="0,0,0,16">
                <TextBlock Text="{Binding ModDescription}"
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrush1}"
                           TextWrapping="Wrap"
                           LineHeight="20" />
            </controls:MyCard>

            <controls:MyCard Title="依赖关系" Margin="0,0,0,16">
                <Border Background="#2D2D2D"
                        CornerRadius="4"
                        Padding="12">
                    <TextBlock Text="{Binding Dependencies}"
                               FontSize="11"
                               Foreground="#E0E0E0"
                               FontFamily="Consolas, Courier New"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </Border>
            </controls:MyCard>

            <controls:MyCard Title="冲突检测" Margin="0,0,0,16">
                <Border Background="#2D2D2D"
                        CornerRadius="4"
                        Padding="12">
                    <TextBlock Text="{Binding Conflicts}"
                               FontSize="11"
                               Foreground="#E0E0E0"
                               FontFamily="Consolas, Courier New"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </Border>
            </controls:MyCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
