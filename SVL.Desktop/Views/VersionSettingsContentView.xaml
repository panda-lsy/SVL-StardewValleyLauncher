                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                            BlurRadius="8"
                                            ShadowDepth="0"
                                            Opacity="0.1"/>
                        </Border.Effect>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenModsFolderCommand}"
                                    Content="打开文件夹"
                                    Height="40"
                                    Margin="0,0,8,8"
                                    Padding="16,0"
                                    FontSize="14"
                                    Foreground="White"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding OpenBackupFolderCommand}"
                                    Content="打开备份栏"
                                    Height="40"
                                    Margin="0,0,8,8"
                                    Padding="16,0"
                                    FontSize="14"
                                    Foreground="White"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding CheckModUpdatesCommand}"
                                    Content="检测更新"
                                    Height="40"
                                    Margin="0,0,8,8"
                                    Padding="16,0"
                                    FontSize="14"
                                    Foreground="White"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBoolConverter}}"
                                    Visibility="{Binding IsBackupFilterActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCheckingUpdates}" Value="True">
                                                            <Setter Property="Opacity" Value="0.6" TargetName="ButtonBorder"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding CheckModLocalizationCommand}"
                                    Content="检测汉化"
                                    Height="40"
                                    Margin="0,0,8,8"
                                    Padding="16,0"
                                    FontSize="14"
                                    Foreground="White"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsCheckingLocalization, Converter={StaticResource InverseBoolConverter}}"
                                    Visibility="{Binding IsBackupFilterActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCheckingLocalization}" Value="True">
                                                            <Setter Property="Opacity" Value="0.6" TargetName="ButtonBorder"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding SelectAllCommand}"
                                    Content="全选"
                                    ToolTip="全选/取消全选当前分类下所有页的 Mod"
                                    Height="40"
                                    Margin="0,0,8,8"
                                    Padding="16,0"
                                    FontSize="14"
                                    Foreground="White"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding RefreshModsCommand}"
                                    Content="刷新"
                                    Height="40"
                                    Margin="0,0,8,8"
                                    Padding="16,0"
                                    FontSize="14"
                                    Foreground="{DynamicResource ColorBrush1}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding InstallModFromFileCommand}"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,8"
                                    Cursor="Hand"
                                    ToolTip="从本地安装 Mod">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                            CornerRadius="6"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="+"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasRunningModTask, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                            BlurRadius="8"
                                            ShadowDepth="0"
                                            Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="任务进度"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrush1}"
                                       Margin="0,0,0,16"/>

                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource ColorBrushGray3}">
                                    <Run Text="更新检测 - 当前处理："/>
                                    <Run Text="{Binding CurrentUpdateProcessingModName, Mode=OneWay}"
                                         Foreground="{DynamicResource ColorBrush1}"
                                         FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding UpdateStatus, Mode=OneWay}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorBrush1}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsCheckingLocalization, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource ColorBrushGray3}">
                                    <Run Text="汉化检测 - 当前处理："/>
                                    <Run Text="{Binding CurrentLocalizationProcessingModName, Mode=OneWay}"
                                         Foreground="{DynamicResource ColorBrush1}"
                                         FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding LocalizationStatus, Mode=OneWay}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorBrush1}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- MOD 列表卡片 -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                            BlurRadius="8"
                                            ShadowDepth="0"
                                            Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>

                        <!-- 过滤器栏 -->
                        <Border
                                    Background="{DynamicResource ColorBrushTransparentBackground}"
                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                    BorderThickness="0,0,0,1"
                                    Padding="20,16,20,16">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <RadioButton Content="全部"
                                                 IsChecked="{Binding CurrentFilterCategory, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All}"
                                                 Margin="0,0,16,0"
                                                 FontSize="14"
                                                 Foreground="{DynamicResource ColorBrush1}"
                                                 GroupName="ModFilter">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="RadioButton">
                                                                    <Border x:Name="Border"
                                                                            Background="{DynamicResource ColorBrush5}"
                                                                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                                            BorderThickness="1"
                                                                            Padding="8,4"
                                                                            Cursor="Hand">
                                                                        <StackPanel Orientation="Horizontal" Margin="0">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"/>
                                                                            <TextBlock x:Name="AllCountText"
                                                                                       Text="{Binding TotalModsCount, StringFormat=({0})}"
                                                                                       FontSize="12"
                                                                                       Foreground="{TemplateBinding Foreground}"
                                                                                       Margin="8,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush4}" TargetName="Border"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="Border"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" TargetName="Border"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="TextElement.Foreground" Value="White" TargetName="Border"/>
                                                                            <Setter Property="Foreground" Value="White" TargetName="AllCountText"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton Content="启用"
                                                         IsChecked="{Binding CurrentFilterCategory, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Enabled}"
                                                         Margin="0,0,16,0"
                                                         FontSize="14"
                                                         Foreground="{DynamicResource ColorBrush1}"
                                                         GroupName="ModFilter">
                                                <RadioButton.Style>
                                                    <Style TargetType="RadioButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="RadioButton">
                                                                    <Border x:Name="Border"
                                                                            Background="{DynamicResource ColorBrush5}"
                                                                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                                            BorderThickness="1"
                                                                            Padding="8,4"
                                                                            Cursor="Hand">
                                                                        <StackPanel Orientation="Horizontal" Margin="0">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                                                            <TextBlock x:Name="EnabledCountText"
                                                                                       Text="{Binding EnabledModsCount, StringFormat=({0})}"
                                                                                       FontSize="12"
                                                                                       Foreground="{TemplateBinding Foreground}"
                                                                                       Margin="8,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush4}" TargetName="Border"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="Border"/>
