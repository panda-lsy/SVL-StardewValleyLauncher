        <Border Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ModManagement}"
                Background="Transparent"
                Padding="0">
            <StackPanel>
                        <!-- 原版版本警告（仅当不是SMAPI实例时显示） -->
