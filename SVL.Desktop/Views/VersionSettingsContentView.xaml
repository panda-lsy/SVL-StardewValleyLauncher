                                <DropShadowEffect Color="#000000"
                                                BlurRadius="8"
                                                ShadowDepth="0"
                                                Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <!-- 未安装 SMAPI 时的提示 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsBaseWithSmapiInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
