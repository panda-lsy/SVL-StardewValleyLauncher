<UserControl x:Class="SVL.Desktop.Views.VersionSettingsContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="600">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <converters:BoolToEnableDisableIconConverter x:Key="BoolToEnableDisableIconConverter"/>
        <converters:BoolToEnableDisableTipConverter x:Key="BoolToEnableDisableTipConverter"/>
        <Style x:Key="HoverRevealActionPanelStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="MaxWidth" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="8"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="MaxWidth" Value="420"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform X="0"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="MaxWidth" Value="420"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform X="0"/>
                        </Setter.Value>
                    </Setter>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                 To="0"
                                                 Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                 To="8"
                                                 Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel>

        <!-- 概览页面 -->
        <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Overview}">

            <!-- 第一个卡片：版本信息 -->
            <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    BlurRadius="8"
                                    ShadowDepth="0"
                                    Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Border Grid.Column="0"
                            Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{DynamicResource ColorBrushTransparentBackground}"
                            Margin="0,0,20,0">
                        <Image Source="{Binding InstanceIcon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- 版本信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstanceName}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="版本: "
                                       FontSize="14"
                                       Foreground="{DynamicResource ColorBrushGray3}"/>
                            <TextBlock Text="{Binding InstanceVersion}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ColorBrushGray3}"/>
                        </StackPanel>
                        <!-- SMAPI 版本 -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding IsSMAPIInstance, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="SMAPI: "
                                       FontSize="14"
                                       Foreground="{DynamicResource ColorBrushGray3}"/>
                            <TextBlock Text="{Binding SmapiVersion}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ColorBrushGray3}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 第二个卡片：个性化 -->
            <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    BlurRadius="8"
                                    ShadowDepth="0"
                                    Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 标题 -->
                    <TextBlock Text="个性化"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,16"/>

                    <!-- 图标设置 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="图标"
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="更改图标"
                                Command="{Binding ChangeIconCommand}"
                                Width="120"
                                Height="32"
                                HorizontalAlignment="Left"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}"
                                                        Cursor="Hand">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 版本名称 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="版本名称"
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Foreground="{DynamicResource ColorBrush1}"
                                 CaretBrush="{DynamicResource ColorBrush1}"
                                 BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                 TextWrapping="NoWrap">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="Border"
                                                        Background="{DynamicResource ColorBrushTransparentBackground}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}"
                                                        MinHeight="{TemplateBinding MinHeight}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- 版本描述 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="版本描述"
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   VerticalAlignment="Top"
                                   Margin="0,8,0,0"/>

                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Height="80"
                                     Padding="8,6"
                                     FontSize="13"
                                     Foreground="{DynamicResource ColorBrush1}"
                                     CaretBrush="{DynamicResource ColorBrush1}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="{DynamicResource ColorBrushSemiTransparent}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border x:Name="Border"
                                                            Background="{DynamicResource ColorBrushTransparentBackground}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Grid>

                    <!-- 收藏夹 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="收藏夹"
                                   FontSize="14"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   VerticalAlignment="Center"/>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Content="加入收藏夹"
                                  FontSize="14"
                                  Foreground="{DynamicResource ColorBrush1}"
                                  Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 第三个卡片：快捷方式 -->
            <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    BlurRadius="8"
                                    ShadowDepth="0"
                                    Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 标题 -->
                    <TextBlock Text="快捷方式"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,16"/>

                    <!-- 版本文件夹 -->
                    <Button Command="{Binding OpenFolderCommand}"
                            CommandParameter="{Binding InstanceGamePath}"
                            Height="40"
                            Margin="0,0,0,8"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{DynamicResource ColorBrush5}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="16,0">
                                                <Grid>
                                                    <TextBlock Text="📁 版本文件夹"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource ColorBrush1}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 存档文件夹 -->
                    <Button Command="{Binding OpenFolderCommand}"
                            CommandParameter="{Binding SaveFolderPath}"
                            Height="40"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            Visibility="{Binding HasSaveFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{DynamicResource ColorBrush5}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="16,0">
                                                <Grid>
                                                    <TextBlock Text="💾 存档文件夹"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource ColorBrush1}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Mod 文件夹 -->
                    <Button Command="{Binding OpenFolderCommand}"
                            CommandParameter="{Binding ModFolderPath}"
                            Height="40"
                            Cursor="Hand"
                            Visibility="{Binding HasModFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{DynamicResource ColorBrush5}"
                                                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="16,0">
                                                <Grid>
                                                    <TextBlock Text="📦 Mod 文件夹"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource ColorBrush1}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="ButtonBorder"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 第四个卡片：高级管理 -->
            <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    BlurRadius="8"
                                    ShadowDepth="0"
                                    Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 标题 -->
                    <TextBlock Text="高级管理"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,16"/>

                    <!-- 警告提示 -->
                    <Border Background="#FFF3E0"
                            BorderBrush="#FFB74D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="危险操作区域：以下操作不可逆，请谨慎操作"
                                       FontSize="13"
                                       Foreground="#E65100"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding UninstallBaseSmapiCommand}"
                            Height="44"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            Visibility="{Binding CanUninstallBaseSmapi, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF8C00"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="16,0">
                                                <Grid>
                                                    <TextBlock Text="🧹 卸载 Base SMAPI"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EF6C00" TargetName="ButtonBorder"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#E65100" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 删除版本按钮 -->
                    <Button Command="{Binding DeleteVersionCommand}"
                            IsEnabled="{Binding CanDeleteVersion}"
                            Height="44"
                            Cursor="Hand"
                            ToolTip="Base 版本不可删除，仅可卸载其 SMAPI。">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF5252"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="16,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding DeleteVersionButtonText}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D32F2F" TargetName="ButtonBorder"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#C62828" TargetName="ButtonBorder"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#9E9E9E" TargetName="ButtonBorder"/>
                                                    <Setter Property="Opacity" Value="0.88" TargetName="ButtonBorder"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="{Binding DeleteVersionHintText}"
                               Margin="0,10,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 自动安装页面 -->
        <StackPanel Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AutoInstall}">
            <!-- 版本信息卡片 -->
            <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    BlurRadius="8"
                                    ShadowDepth="0"
                                    Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Border Grid.Column="0"
                            Width="64"
                            Height="64"
                            CornerRadius="8"
                            Background="{DynamicResource ColorBrushTransparentBackground}"
                            Margin="0,0,20,0">
                        <Image Source="{Binding InstanceIcon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- 版本信息 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstanceName}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   TextWrapping="Wrap"/>
                        <!-- 原版版本 -->
                        <TextBlock FontSize="14"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,8,0,0">
                            <Run Text="🎮 原版: "/>
                            <Run Text="{Binding InstanceVersion, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- SMAPI 版本（可点击更改）-->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding IsSMAPIInstance, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="14"
                                       Foreground="{DynamicResource ColorBrushGray3}">
                                <Run Text="🔧 SMAPI: "/>
                            </TextBlock>
                            <TextBlock Text="{Binding SmapiVersion, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ColorBrush3}"
                                       Cursor="Hand"
                                       TextDecorations="Underline"
                                       ToolTip="点击更改 SMAPI 版本"
                                       FontWeight="Medium">
                                <TextBlock.InputBindings>
                                    <MouseBinding Command="{Binding ChangeSmapiVersionCommand}"
                                                  MouseAction="LeftClick"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                        <!-- 无 SMAPI 提示 -->
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsSMAPIInstance, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <Run Text="💡 当前为原版，点击下方按钮安装 SMAPI"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 安装选项卡片 -->
            <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                    BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    BlurRadius="8"
                                    ShadowDepth="0"
                                    Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="安装选项"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,16"/>

                    <!-- 安装/更新 SMAPI 按钮 -->
                    <Button Command="{Binding ChangeSmapiVersionCommand}"
                            Height="48"
                            Margin="0,0,0,12"
                            Cursor="Hand"
                            IsEnabled="{Binding IsBaseWithSmapiInstalled, Converter={StaticResource InverseBoolConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
