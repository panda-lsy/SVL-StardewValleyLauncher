                                                        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushSemiTransparent}"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#16D2A679"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#30D2A679"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
