                                                                            <Setter Property="Background" Value="#28D2A679"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Width="4"
                                                                        Margin="-16,-10,12,-10"
                                                                        HorizontalAlignment="Left"
                                                                        CornerRadius="8,0,0,8">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>

                                                                <Grid Grid.Column="0"
                                                                      Width="28"
                                                                      Height="28"
                                                                      Margin="0,0,12,0"
                                                                      VerticalAlignment="Top"
                                                                      IsHitTestVisible="False">
                                                                    <Ellipse Width="18"
                                                                             Height="18"
                                                                             Stroke="{DynamicResource ColorBrush2}"
                                                                             StrokeThickness="2"
                                                                             Fill="Transparent"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                                    <Ellipse Width="10"
                                                                             Height="10"
                                                                             Fill="{DynamicResource ColorBrush2}"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                </Grid>

                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource ColorBrush1}"
                                                                               TextWrapping="NoWrap">
                                                                          <Run Text="{Binding FolderName, Mode=OneWay}"
                                                                             FontSize="13"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource ColorBrush1}"/>
                                                                        <Run Text=" | "
                                                                             FontSize="12"
                                                                             Foreground="{DynamicResource ColorBrushGray3}"/>
                                                                                                  <Run Text="{Binding DisplayName, Mode=OneWay}"
                                                                             FontSize="12"
                                                                             Foreground="{DynamicResource ColorBrush1}"/>
                                                                        <Run Text=" | 子 Mod"
                                                                             FontSize="12"
                                                                             Foreground="{DynamicResource ColorBrushGray3}"/>
                                                                    </TextBlock>

                                                                    <TextBlock Margin="0,2,0,0"
                                                                               Foreground="{DynamicResource ColorBrushGray3}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="NoWrap">
                                                                        <Run Text="描述："
                                                                             FontSize="12"
                                                                             Foreground="{DynamicResource ColorBrushGray3}"/>
                                                                                                  <Run Text="{Binding DisplayDescription, Mode=OneWay}"
                                                                             FontSize="12"
                                                                             Foreground="{DynamicResource ColorBrushGray3}"/>
                                                                    </TextBlock>

                                                                    <TextBlock Margin="0,2,0,0"
                                                                               Foreground="{DynamicResource ColorBrushGray3}"
                                                                               Visibility="{Binding TagsDisplay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                                        <Run Text="标签："
                                                                             FontSize="12"
                                                                             Foreground="{DynamicResource ColorBrushGray3}"/>
                                                                          <Run Text="{Binding TagsDisplay, Mode=OneWay}"
                                                                             FontSize="12"
                                                                             Foreground="{DynamicResource ColorBrushGray3}"/>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Style="{StaticResource HoverRevealActionPanelStyle}">
                                                                    <Button Command="{Binding DataContext.ToggleModLocalizationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="32"
                                                                            Height="32"
                                                                            Margin="4,0"
                                                                            Cursor="Hand"
                                                                            ToolTip="切换中文/英文显示"
                                                                            Visibility="{Binding HasAnyLocalization, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsUsingLocalizedText}" Value="True">
                                                                                        <Setter Property="Background" Value="#1FD2A679"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <TextBlock Text="文"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                                                    </Button>

                                                                    <Button Command="{Binding DataContext.ShowLocalModDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="32"
                                                                            Height="32"
                                                                            Margin="4,0"
                                                                            Cursor="Hand"
                                                                            ToolTip="查看本地详情"
                                                                            Background="Transparent"
                                                                            BorderThickness="0">
                                                                        <TextBlock Text="📄"
                                                                                   FontSize="14"
                                                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                                                    </Button>

                                                                    <Button Command="{Binding DataContext.OpenModLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="32"
                                                                            Height="32"
                                                                            Margin="4,0"
                                                                            Cursor="Hand"
                                                                            ToolTip="打开文件位置"
                                                                            Background="Transparent"
                                                                            BorderThickness="0">
                                                                        <TextBlock Text="📁"
                                                                                   FontSize="14"
                                                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                                                    </Button>

                                                                    <Button Command="{Binding DataContext.ToggleModEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="32"
                                                                            Height="32"
                                                                            Margin="4,0"
                                                                            Cursor="Hand"
                                                                            ToolTip="{Binding IsEnabled, Converter={StaticResource BoolToEnableDisableTipConverter}}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0">
                                                                        <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToEnableDisableIconConverter}}"
                                                                                   FontSize="14"
                                                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                                                    </Button>

                                                                    <Button Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="32"
                                                                            Height="32"
                                                                            Margin="4,0"
                                                                            Cursor="Hand"
                                                                            ToolTip="删除"
                                                                            Background="Transparent"
                                                                            BorderThickness="0">
                                                                        <TextBlock Text="🗑️"
                                                                                   FontSize="14"
                                                                                   Foreground="{DynamicResource ColorBrush1}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,10"
                                    Background="{DynamicResource ColorBrushTransparentBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TotalFilteredCount, StringFormat=共 {0} 项}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ColorBrushGray3}"/>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding PreviousPageCommand}"
                                                Content="上一页"
                                                Width="70"
                                                Height="32"
                                                Margin="0,0,8,0"
                                                FontSize="12"
                                                Background="{DynamicResource ColorBrush2}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                IsEnabled="{Binding HasPreviousPage}"
                                                FocusVisualStyle="{x:Null}"
                                                IsTabStop="False">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <ItemsControl ItemsSource="{Binding PageNumbers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="..."
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"
                                                                   Visibility="{Binding ., Converter={StaticResource NegativeIntToCollapsedConverter}}" />

                                                        <Button Content="{Binding .}"
                                                                Width="36"
                                                                Height="32"
                                                                Margin="2,0"
                                                                FontSize="12"
                                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding .}"
                                                                Visibility="{Binding ., Converter={StaticResource PositiveIntToCollapsedConverter}}"
                                                                FocusVisualStyle="{x:Null}"
                                                                IsTabStop="False">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorBrushGray5}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        CornerRadius="4"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource PageNumberToBoolConverter}">
                                                                                    <Binding Path="." />
                                                                                    <Binding Path="DataContext.CurrentPageIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Command="{Binding NextPageCommand}"
                                                Content="下一页"
                                                Width="70"
                                                Height="32"
                                                Margin="8,0,0,0"
                                                FontSize="12"
                                                Background="{DynamicResource ColorBrush2}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                IsEnabled="{Binding HasNextPage}"
                                                FocusVisualStyle="{x:Null}"
                                                IsTabStop="False">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                                <!-- 空状态 -->
                                <TextBlock Text="暂无 MOD"
                                           FontSize="14"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           HorizontalAlignment="Center"
                                           Margin="0,40,0,40"
                                           Visibility="{Binding FilteredMods.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </StackPanel>
            </Border>
            </StackPanel>
    </Grid>
</UserControl>
