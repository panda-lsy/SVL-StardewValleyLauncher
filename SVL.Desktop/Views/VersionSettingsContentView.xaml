                                               FontSize="14"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <!-- 已安装 SMAPI 但未切换时的提示 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsBaseWithSmapiInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="🔧"
                                               FontSize="24"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SwitchToSMAPITipText}"
                                               FontSize="14"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Button Content="切换到 SMAPI"
                                            Command="{Binding SwitchToSMAPIVersionCommand}"
                                            Width="120"
                                            Height="32"
                                            Margin="12,0,0,0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ButtonBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Cursor="Hand">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    <!-- SMAPI 实例时显示 MOD 管理界面 -->
                    <StackPanel Visibility="{Binding IsSMAPIInstance, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,92">
                    <!-- 第一个卡片：本地搜索 -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                            BlurRadius="8"
                                            ShadowDepth="0"
                                            Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontSize="20"
                                       Foreground="{DynamicResource ColorBrush1}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Foreground="{DynamicResource ColorBrush1}"
                                     CaretBrush="{DynamicResource ColorBrush1}"
                                     BorderBrush="{DynamicResource ColorBrushSemiTransparent}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border x:Name="Border"
                                                            Background="{DynamicResource ColorBrushTransparentBackground}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
