                                                                      VerticalAlignment="Center"
                                                                      Margin="0"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- 第二个卡片：文件夹操作 -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
