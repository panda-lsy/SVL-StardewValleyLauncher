                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}" TargetName="Border"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" TargetName="Border"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="TextElement.Foreground" Value="White" TargetName="Border"/>
                                                                            <Setter Property="Foreground" Value="White" TargetName="BackupCountText"/>
