<UserControl x:Class="SVL.Desktop.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="600">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <StackPanel>

        <!-- ═══════════════ Card 1: 整合包基本信息 ═══════════════ -->
        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.1"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="整合包信息"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,16"/>

                <!-- 名称 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="整合包名称"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding ModpackName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Foreground="{DynamicResource ColorBrush1}"
                             CaretBrush="{DynamicResource ColorBrush1}"
                             BorderBrush="{DynamicResource ColorBrushSemiTransparent}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="Border"
                                                    Background="{DynamicResource ColorBrushTransparentBackground}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    MinHeight="{TemplateBinding MinHeight}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 版本 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="整合包版本"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding ModpackVersion, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Foreground="{DynamicResource ColorBrush1}"
                             CaretBrush="{DynamicResource ColorBrush1}"
                             BorderBrush="{DynamicResource ColorBrushSemiTransparent}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="Border"
                                                    Background="{DynamicResource ColorBrushTransparentBackground}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    MinHeight="{TemplateBinding MinHeight}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 作者 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="作者"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding ModpackAuthor, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="32"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Foreground="{DynamicResource ColorBrush1}"
                             CaretBrush="{DynamicResource ColorBrush1}"
                             BorderBrush="{DynamicResource ColorBrushSemiTransparent}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="Border"
                                                    Background="{DynamicResource ColorBrushTransparentBackground}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    MinHeight="{TemplateBinding MinHeight}">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- SMAPI 版本信息 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="版本信息"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ColorBrush5}"
                            CornerRadius="4"
                            Padding="8,4">
                        <TextBlock Text="{Binding SmapiVersionDisplay}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="3"
                            Background="{DynamicResource ColorBrush5}"
                            CornerRadius="4"
                            Padding="8,4">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   VerticalAlignment="Center">
                            <Run Text="游戏 "/>
                            <Run Text="{Binding GameVersionDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Card 2: 导出内容 ═══════════════ -->
        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.1"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="导出内容"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,16"/>

                <!-- Mod 列表 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Mod 列表"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IncludeMods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="14"
                              Foreground="{DynamicResource ColorBrush1}"
                              Cursor="Hand">
                        <CheckBox.Content>
                            <TextBlock>
                                <Run Text="导出 Mod 清单"/>
                                <Run Text="{Binding SelectedModCount, Mode=OneWay, StringFormat=' ({0}'}" Foreground="{DynamicResource ColorBrush2}"/>
                                <Run Text="{Binding TotalModCount, Mode=OneWay, StringFormat='/{0})'}" Foreground="{DynamicResource ColorBrushGray3}"/>
                            </TextBlock>
                        </CheckBox.Content>
                    </CheckBox>
                </Grid>

                <!-- Mod 设置 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Mod 设置"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IncludeModSettings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Content="导出 Mod 配置文件（config.json 等）"
                              FontSize="14"
                              Foreground="{DynamicResource ColorBrush1}"
                              Cursor="Hand"/>
                </Grid>

                <!-- SVL 启动器 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="SVL 启动器"
                               FontSize="14"
                               Foreground="{DynamicResource ColorBrush1}"
                               VerticalAlignment="Center"/>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IncludeSvlLauncher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Content="导出 SVL 启动器程序"
                              FontSize="14"
                              Foreground="{DynamicResource ColorBrush1}"
                              Cursor="Hand"/>
                </Grid>

                <!-- Mod 列表展示 -->
                <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                        BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0"
                        Visibility="{Binding IncludeMods, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel>
                        <!-- 列表头部 -->
                        <Grid Background="{DynamicResource ColorBrush5}"
                              Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"
                                      Command="{Binding ToggleSelectAllCommand}"
                                      Margin="0,6"/>

                            <TextBlock Grid.Column="1"
                                       Text="名称"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrush1}"
                                       Padding="8,6"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       Text="版本"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrush1}"
                                       Padding="4,6"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="来源"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrush1}"
                                       Padding="4,6"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Mod 条目列表 -->
                        <ItemsControl ItemsSource="{Binding ExportModItems}"
                                      MaxHeight="300">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Style="{StaticResource ModernScrollViewerStyle}"
                                                  MaxHeight="300">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand"
                                                  Margin="0,4"/>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical"
                                                    Margin="8,4">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ColorBrush1}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ColorBrushGray3}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Version}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ColorBrushGray3}"
                                                   Padding="4,4"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SourceDescription}"
                                                   FontSize="11"
                                                   Padding="4,4"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray3}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSourceCredential}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 分隔线 -->
                                        <Border Grid.ColumnSpan="4"
                                                Height="1"
                                                Background="{DynamicResource ColorBrushSemiTransparent}"
                                                VerticalAlignment="Bottom"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Card 3: 导出策略说明 ═══════════════ -->
        <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                BorderBrush="{DynamicResource ColorBrushSemiTransparent}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.1"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="导出策略"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           Margin="0,0,0,12"/>

                <TextBlock Text="为遵循来源平台分发规则，SVL 不再导出 Mod 本体文件。&#x0a;有来源信息的 Mod 将仅导出清单和来源；无来源信息的 Mod 仅导出配置文件（config.json 等）。"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════ 状态栏 + 按钮 ═══════════════ -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧状态 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 进度条 -->
                <ProgressBar Value="{Binding ExportProgress}"
                             Maximum="100"
                             Height="4"
                             Margin="0,6,16,0"
                             Background="{DynamicResource ColorBrush5}"
                             Foreground="{DynamicResource ColorBrush2}"
                             BorderThickness="0"
                             Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 右侧按钮 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <!-- 保存配置 -->
                <Button Content="保存配置"
                        Command="{Binding SaveConfigCommand}"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" TargetName="ButtonBorder"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 读取配置 -->
                <Button Content="读取配置"
                        Command="{Binding LoadConfigCommand}"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" TargetName="ButtonBorder"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 开始导出 -->
                <Button Content="开始导出"
                        Command="{Binding StartExportCommand}"
                        Width="100"
                        Height="36"
                        Cursor="Hand"
                        IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBoolConverter}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ColorBrush3}" TargetName="ButtonBorder"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
