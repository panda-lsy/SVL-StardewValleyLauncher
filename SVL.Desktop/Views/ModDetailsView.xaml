<UserControl x:Class="SVL.Desktop.Views.ModDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModel="clr-namespace:SVL.Desktop.ViewModels"
             xmlns:converters="clr-namespace:SVL.Desktop.Converters"
             xmlns:controls="clr-namespace:SVL.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:ModDetailsViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:LongToFileSizeConverter x:Key="FileSizeConverter"/>
        <converters:UrlToVisibilityConverter x:Key="UrlToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{DynamicResource ModernScrollViewerStyle}">
        <StackPanel Margin="20">

            <!-- ===== MOD 基本信息 Card ===== -->
            <controls:MyCard Margin="0,0,0,20">
                <Grid Margin="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- MOD Icon -->
                    <Border Grid.Column="0"
                            Width="96"
                            Height="96"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Margin="0,0,24,0"
                            Background="{DynamicResource ColorBrush3}">
                        <Image Source="{Binding Mod.LocalIconPath, Converter={StaticResource ImagePathConverter}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect Color="Black"
                                                  Opacity="0.3"
                                                  BlurRadius="8"
                                                  ShadowDepth="4"/>
                            </Image.Effect>
                        </Image>
                    </Border>

                    <!-- MOD 信息 -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Mod.Name}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <!-- 统计信息 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}">
                                    <Run Text="作者: "/>
                                    <Run Text="{Binding Mod.Author}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}">
                                    <Run Text="来源: "/>
                                    <Run Text="{Binding Mod.Source}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <!-- 非 GitHub：下载量 -->
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mod.Source}" Value="GitHub">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Mod.DownloadCount, Converter={StaticResource LongToNumberConverter}}"/>
                                    <Run Text=" 次下载，更新于 "/>
                                    <Run Text="{Binding Mod.LastUpdateTime}"/>
                                </TextBlock>

                                <!-- GitHub：Star 数 -->
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mod.Source}" Value="GitHub">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="★ "/>
                                    <Run Text="{Binding Mod.DownloadCount, Converter={StaticResource LongToNumberConverter}}"/>
                                    <Run Text=" Star，更新于 "/>
                                    <Run Text="{Binding Mod.LastUpdateTime}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 描述（放在作者/来源下一行） -->
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Margin="0,0,0,0"
                                   Visibility="{Binding HasAnyDescription, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="描述："/>
                            <Run Text="{Binding DisplayDescription, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Top">
                        <Button Content="转到来源"
                                Width="100"
                                Height="32"
                                FontSize="12"
                                Command="{Binding OpenSourceUrlCommand}"
                                Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ColorBrush1}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding CopyNameCommand}"
                                Content="复制名称"
                                Width="100"
                                Height="32"
                                FontSize="12"
                                Background="{DynamicResource ColorBrush3}"
                                Foreground="{DynamicResource ColorBrush1}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Command="{Binding CopyIdCommand}"
                                Content="复制 ID"
                                Width="100"
                                Height="32"
                                FontSize="12"
                                Background="{DynamicResource ColorBrush3}"
                                Foreground="{DynamicResource ColorBrush1}"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:MyCard>

            <!-- ===== 支持的游戏版本 Tag 列表 ===== -->
            <controls:MyCard Margin="0,0,0,20">
                <StackPanel Margin="5">
                    <TextBlock Text="支持的游戏版本"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}"
                               Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding DisplayedGameVersions}" Tag="{Binding SelectedGameVersion}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,0,8,8"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                                                            <Binding Path="." Mode="OneWay"/>
                                                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}" Mode="OneWay"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding}"
                                               FontSize="13"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                                                                <Binding Path="." Mode="OneWay"/>
                                                                <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}" Mode="OneWay"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectGameVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:MyCard>

            <!-- ===== 各游戏版本的 MOD 版本列表 Card ===== -->
            <ItemsControl ItemsSource="{Binding DisplayedVersionsByGameVersion}" Tag="{Binding SelectedGameVersion}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MyCard Margin="0,0,0,20">
                            <StackPanel Margin="5">
                                    <!-- 标题行：游戏版本 + 展开/折叠按钮 -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ColorBrush1}"
                                                   VerticalAlignment="Center">
                                            <Run Text=" Stardew Valley "/>
                                            <Run Text="{Binding GameVersion}"/>
                                        </TextBlock>

                                        <!-- 展开/折叠按钮 -->
                                        <Button Grid.Column="1"
                                                Content="{Binding IsExpanded, Converter={StaticResource ExpandButtonLabelConverter}}"
                                                Width="80"
                                                Height="36"
                                                Margin="12,0,0,0"
                                                FontSize="13"
                                                Command="{Binding DataContext.ToggleGameVersionExpandedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <!-- 版本列表（可展开） -->
                                    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                                  Background="Transparent"
                                                  Focusable="False"
                                                  MaxHeight="300"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Margin="0,12,0,0">
                                        <ItemsControl ItemsSource="{Binding PagedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ColorBrush5}"
                                                            CornerRadius="6"
                                                            Padding="12,8"
                                                            Margin="0,0,0,8"
                                                            Cursor="Hand">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- 版本状态图标 -->
                                                                <Rectangle Grid.Column="0"
                                                                         Width="32"
                                                                         Height="32"
                                                                         Margin="0,0,12,0"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{Binding ReleaseType, Converter={StaticResource ReleaseTypeToIconConverter}}"/>

                                                                <!-- 文件信息 -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="加载中，请稍等..."
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource ColorBrushGray3}"
                                                                           Margin="0,0,0,4"
                                                                           Visibility="{Binding IsLoadingPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                                <!-- 标题：[游戏版本] 文件名（无扩展名） -->
                                                                <TextBlock FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource ColorBrush1}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,0,4">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoadingPlaceholder}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <Run Text="["/>
                                                                    <Run Text="{Binding GameVersion}"/>
                                                                    <Run Text="] "/>
                                                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                                                </TextBlock>

                                                                <!-- 文件名和下载信息 -->
                                                                <!-- Curseforge：显示下载次数 + 更新时间 -->
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{DynamicResource ColorBrushGray3}"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding DataContext.IsCurseforgeSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoadingPlaceholder}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DataContext.IsCurseforgeSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <Run Text="{Binding FileName}"/>
                                                                    <Run Text="  "/>
                                                                    <Run Text="下载："/>
                                                                    <Run Text="{Binding DownloadCount, Converter={StaticResource LongToNumberConverter}}"/>
                                                                    <Run Text=" 次，最后更新："/>
                                                                    <Run Text="{Binding UploadTime}"/>
                                                                </TextBlock>

                                                                <!-- GitHub 和 NexusMods：只显示文件名和更新时间 -->
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{DynamicResource ColorBrushGray3}"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding DataContext.IsGithubOrNexusSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoadingPlaceholder}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DataContext.IsGithubOrNexusSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <Run Text="{Binding FileName}"/>
                                                                    <Run Text="  "/>
                                                                    <Run Text="最后更新："/>
                                                                    <Run Text="{Binding UploadTime}"/>
                                                                </TextBlock>
                                                                </StackPanel>

                                                                <!-- 操作按钮 -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoadingPlaceholder}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button Content="安装"
                                                                            Width="70"
                                                                            Height="32"
                                                                            FontSize="12"
                                                                            Command="{Binding DataContext.DownloadModCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background" Value="{DynamicResource ColorBrush2}"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <Border Background="{TemplateBinding Background}"
                                                                                                    CornerRadius="4"
                                                                                                    Padding="{TemplateBinding Padding}">
                                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                                VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>

                                                                    <Button Content="另存为"
                                                                            Width="70"
                                                                            Height="32"
                                                                            FontSize="12"
                                                                            Margin="8,0,0,0"
                                                                            Command="{Binding DataContext.SaveModAsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}"/>
                                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <Border Background="{TemplateBinding Background}"
                                                                                                    CornerRadius="4"
                                                                                                    Padding="{TemplateBinding Padding}">
                                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                                VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Style.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush5}"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>

                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>

                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 分组分页（每页 5 条） -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,10,0,0"
                                                    Visibility="{Binding TotalPages, Converter={StaticResource IntGreaterThanOneToVisibilityConverter}}">
                                            <Button Command="{Binding PrevPageCommand}"
                                                    Content="上一页"
                                                    Width="70"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    FontSize="12"
                                                    Background="{DynamicResource ColorBrush2}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding HasPreviousPage}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <TextBlock Text="{Binding PageText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ColorBrushGray3}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>

                                            <Button Command="{Binding NextPageCommand}"
                                                    Content="下一页"
                                                    Width="70"
                                                    Height="32"
                                                    FontSize="12"
                                                    Background="{DynamicResource ColorBrush2}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding HasNextPage}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                        <!-- GitHub 版本兼容筛选：分页（与 ModSearch 同款页码条，每页 5 条） -->
                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <controls:MyCard Margin="0,10,0,0"
                                                             HorizontalAlignment="Center"
                                                             Visibility="{Binding DataContext.ShowGithubCompatiblePaging, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,1">
                                                    <!-- 上一页 -->
                                                    <Button Command="{Binding DataContext.GithubCompatiblePrevPageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            Content="上一页"
                                                            Width="70"
                                                            Height="32"
                                                            Margin="0,0,8,0"
                                                            FontSize="12"
                                                            Background="{DynamicResource ColorBrush2}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            IsEnabled="{Binding DataContext.GithubCompatibleHasPreviousPage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            FocusVisualStyle="{x:Null}"
                                                            IsTabStop="False">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- 页码 -->
                                                    <ItemsControl ItemsSource="{Binding DataContext.GithubCompatiblePageNumbers, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <!-- 省略号 (-1) -->
                                                                    <TextBlock Text="..."
                                                                               FontSize="14"
                                                                               Foreground="{DynamicResource ColorBrushGray3}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="4,0"
                                                                               Visibility="{Binding ., Converter={StaticResource NegativeIntToCollapsedConverter}}" />

                                                                    <!-- 页码按钮 -->
                                                                    <Button Content="{Binding .}"
                                                                            Width="36"
                                                                            Height="32"
                                                                            Margin="2,0"
                                                                            FontSize="12"
                                                                        Command="{Binding DataContext.GithubCompatibleGoToPageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            CommandParameter="{Binding .}"
                                                                            Visibility="{Binding ., Converter={StaticResource PositiveIntToCollapsedConverter}}"
                                                                            FocusVisualStyle="{x:Null}"
                                                                            IsTabStop="False">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background" Value="{DynamicResource ColorBrushGray5}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
                                                                                <Setter Property="BorderThickness" Value="0" />
                                                                                <Setter Property="Cursor" Value="Hand" />
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <Border Background="{TemplateBinding Background}"
                                                                                                    CornerRadius="4"
                                                                                                    Padding="{TemplateBinding Padding}">
                                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                                VerticalAlignment="Center" />
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Style.Triggers>
                                                                                    <!-- 当前页高亮 -->
                                                                                    <DataTrigger Value="True">
                                                                                        <DataTrigger.Binding>
                                                                                            <MultiBinding Converter="{StaticResource PageNumberToBoolConverter}">
                                                                                                <Binding Path="." />
                                                                                                <Binding Path="DataContext.GithubCompatiblePage" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                                            </MultiBinding>
                                                                                        </DataTrigger.Binding>
                                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                                    </DataTrigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 下一页 -->
                                                    <Button Command="{Binding DataContext.GithubCompatibleNextPageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            Content="下一页"
                                                            Width="70"
                                                            Height="32"
                                                            Margin="8,0,0,0"
                                                            FontSize="12"
                                                            Background="{DynamicResource ColorBrush2}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            IsEnabled="{Binding DataContext.GithubCompatibleHasNextPage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            FocusVisualStyle="{x:Null}"
                                                            IsTabStop="False">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </controls:MyCard>
                                        </StackPanel>
                                </StackPanel>
                        </controls:MyCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
